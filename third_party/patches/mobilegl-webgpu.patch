     Bool BackendObject_DirectWebGPU::InitCapabilities() {
+        // Core WebGPU guarantees 4x multisampling for render attachments.  The
+        // renderer implements GL multisampled renderbuffers with an explicit
+        // single-sample resolve companion.
+        m_dynamicParameters.MaxSamples = 4;
+        m_dynamicParameters.MaxColorTextureSamples = 4;
+        m_dynamicParameters.MaxDepthTextureSamples = 4;
+        m_dynamicParameters.MaxFramebufferSamples = 4;
+
+        FormatCapabilityCache& cache = MutableFormatCapabilities();
+        cache.Clear();
+        const SizeT renderbufferTarget = GetRenderbufferFormatCapabilityTargetIndex();
+        for (SizeT formatIndex = 0; formatIndex < kFormatCapabilityFormatCount; ++formatIndex) {
+            const auto format = static_cast<TextureInternalFormat>(formatIndex);
+            const WebGPUFormatTraits traits = GetWebGPUFormatTraits(format);
+            if (!traits.Supported) continue;
+
+            FormatCapabilityFlags sampledCaps = FormatCapability::Creatable |
+                                                FormatCapability::Sampled;
+            if (traits.Filterable) sampledCaps |= FormatCapability::LinearFilter;
+            if (traits.Depth && !traits.Stencil) sampledCaps |= FormatCapability::TextureShadow;
+
+            FormatCapabilityFlags attachmentCaps = FormatCapability::FramebufferRenderable;
+            if (traits.Depth) attachmentCaps |= FormatCapability::DepthAttachment;
+            if (traits.Stencil) attachmentCaps |= FormatCapability::StencilAttachment;
+            if (!traits.Depth && !traits.Stencil) attachmentCaps |= FormatCapability::ColorAttachment;
+
+            // These are the only target classes materialized by WebGPURenderer today.
+            constexpr TextureTarget sampledTargets[] = {
+                TextureTarget::Texture2D,
+                TextureTarget::Texture3D,
+                TextureTarget::TextureCubeMap,
+                TextureTarget::Texture2DArray,
+            };
+            for (TextureTarget target : sampledTargets) {
+                if (traits.Depth && target == TextureTarget::Texture3D) continue;
+                const SizeT targetIndex = GetFormatCapabilityTargetIndex(target);
+                cache.FullCaps[targetIndex][formatIndex] = sampledCaps | attachmentCaps;
+            }
+
+            // WebGPU's multisampled textures are render attachments, not sampleable
+            // textures.  Report only the capability the renderer actually implements.
+            const SizeT multisampleTarget =
+                GetFormatCapabilityTargetIndex(TextureTarget::Texture2DMultisample);
+            cache.FullCaps[multisampleTarget][formatIndex] =
+                attachmentCaps | FormatCapability::Creatable | FormatCapability::MultisampleTexture;
+            cache.SampleCounts[multisampleTarget][formatIndex] = {4, 1};
+
+            cache.FullCaps[renderbufferTarget][formatIndex] =
+                attachmentCaps | FormatCapability::Creatable | FormatCapability::MultisampleRenderbuffer;
+            cache.SampleCounts[renderbufferTarget][formatIndex] = {4, 1};
+        }
         return true;
     }
 

+
+#include <unordered_map>
+#include <unordered_set>
+#include <vector>
+
+namespace MobileGL::MG_Util::ShaderTranspiler {
+    namespace {
+        using spvtools::opt::Instruction;
+
+        bool IsIntegerImage(spvtools::opt::analysis::DefUseManager* defs,
+                            const Instruction& imageType) {
+            if (imageType.opcode() != spv::Op::OpTypeImage) {
+                return false;
+            }
+            const Instruction* sampledType =
+                defs->GetDef(imageType.GetSingleWordInOperand(0));
+            return sampledType != nullptr && sampledType->opcode() == spv::Op::OpTypeInt;
+        }
+
+        struct IntegerSamplerUses {
+            std::vector<Instruction*> loads;
+            std::vector<Instruction*> imageExtracts;
+            bool safe = true;
+        };
+
+        IntegerSamplerUses AnalyzeIntegerSamplerUses(
+            spvtools::opt::analysis::DefUseManager* defs, uint32_t sampledImageType) {
+            IntegerSamplerUses uses;
+
+            // A helper function taking/returning a sampler, OpPhi, OpSelect, etc. needs a
+            // general value-flow rewrite. Restrict legalization to direct uniform loads,
+            // which is glslang's normal form for texture()/textureLod()/texelFetch().
+            defs->ForEachUser(sampledImageType, [&](Instruction* typeUser) {
+                switch (typeUser->opcode()) {
+                case spv::Op::OpTypePointer:
+                case spv::Op::OpName:
+                    break;
+                case spv::Op::OpLoad: {
+                    uses.loads.push_back(typeUser);
+                    defs->ForEachUser(typeUser->result_id(), [&](Instruction* loadUser) {
+                        if (loadUser->opcode() != spv::Op::OpImage) {
+                            uses.safe = false;
+                            return;
+                        }
+                        if (loadUser->GetSingleWordInOperand(0) != typeUser->result_id()) {
+                            uses.safe = false;
+                            return;
+                        }
+                        uses.imageExtracts.push_back(loadUser);
+                        defs->ForEachUser(loadUser->result_id(), [&](Instruction* imageUser) {
+                            switch (imageUser->opcode()) {
+                            case spv::Op::OpImageFetch:
+                            case spv::Op::OpImageQuerySize:
+                            case spv::Op::OpImageQuerySizeLod:
+                            case spv::Op::OpImageQueryLevels:
+                            case spv::Op::OpImageQuerySamples:
+                                break;
+                            default:
+                                uses.safe = false;
+                                break;
+                            }
+                        });
+                    });
+                    break;
+                }
+                default:
+                    uses.safe = false;
+                    break;
+                }
+            });
+            if (uses.loads.empty()) uses.safe = false;
+            return uses;
+        }
+
+        void FoldFetchConstOffset(spvtools::opt::IRContext* ctx, Instruction* fetch) {
+            if (fetch->opcode() != spv::Op::OpImageFetch || fetch->NumInOperands() < 4) {
+                return;
+            }
+            const uint32_t mask = fetch->GetSingleWordInOperand(2);
+            constexpr uint32_t kConstOffset =
+                static_cast<uint32_t>(spv::ImageOperandsMask::ConstOffset);
+            if ((mask & kConstOffset) == 0) {
+                return;
+            }
+
+            uint32_t offsetOperand = 3;
+            if (mask & static_cast<uint32_t>(spv::ImageOperandsMask::Bias)) {
+                ++offsetOperand;
+            }
+            if (mask & static_cast<uint32_t>(spv::ImageOperandsMask::Lod)) {
+                ++offsetOperand;
+            }
+            if (mask & static_cast<uint32_t>(spv::ImageOperandsMask::Grad)) {
+                offsetOperand += 2;
+            }
+            if (offsetOperand >= fetch->NumInOperands()) {
+                return;
+            }
+
+            const uint32_t coordinateId = fetch->GetSingleWordInOperand(1);
+            const uint32_t offsetId = fetch->GetSingleWordInOperand(offsetOperand);
+            Instruction* coordinate = ctx->get_def_use_mgr()->GetDef(coordinateId);
+            if (coordinate == nullptr) {
+                return;
+            }
+            std::vector<spvtools::opt::Operand> addOperands = {
+                {SPV_OPERAND_TYPE_ID, {coordinateId}},
+                {SPV_OPERAND_TYPE_ID, {offsetId}},
+            };
+            auto add = spvtools::MakeUnique<Instruction>(
+                ctx, spv::Op::OpIAdd, coordinate->type_id(), ctx->TakeNextId(),
+                std::move(addOperands));
+            Instruction* addedCoordinate = fetch->InsertBefore(std::move(add));
+            ctx->AnalyzeDefUse(addedCoordinate);
+
+            const uint32_t newMask = mask & ~kConstOffset;
+            Instruction::OperandList operands;
+            operands.reserve(fetch->NumInOperands() - 1);
+            for (uint32_t i = 0; i < fetch->NumInOperands(); ++i) {
+                if (i == offsetOperand || (i == 2 && newMask == 0)) {
+                    continue;
+                }
+                auto operand = fetch->GetInOperand(i);
+                if (i == 1) {
+                    operand.words = {addedCoordinate->result_id()};
+                } else if (i == 2) {
+                    operand.words = {newMask};
+                }
+                operands.push_back(std::move(operand));
+            }
+            fetch->SetInOperands(std::move(operands));
+            ctx->UpdateDefUse(fetch);
+        }
+    } // namespace
+
+    spvtools::opt::Pass::Status LegalizeIntegerTexelFetchPass::Process() {
+        auto* ctx = context();
+        auto* defs = ctx->get_def_use_mgr();
+        auto* types = ctx->get_type_mgr();
+
+        Instruction* firstGlobalVariable = nullptr;
+        for (Instruction& inst : ctx->types_values()) {
+            if (inst.opcode() == spv::Op::OpVariable) {
+                firstGlobalVariable = &inst;
+                break;
+            }
+        }
+
+        std::unordered_map<uint32_t, uint32_t> sampledToImage;
+        for (Instruction& inst : ctx->types_values()) {
+            if (inst.opcode() != spv::Op::OpTypeSampledImage) {
+                continue;
+            }
+            const uint32_t imageTypeId = inst.GetSingleWordInOperand(0);
+            const Instruction* imageType = defs->GetDef(imageTypeId);
+            if (imageType != nullptr && IsIntegerImage(defs, *imageType)) {
+                sampledToImage.emplace(inst.result_id(), imageTypeId);
+            }
+        }
+
+        bool modified = false;
+        for (const auto& [sampledTypeId, imageTypeId] : sampledToImage) {
+            IntegerSamplerUses uses = AnalyzeIntegerSamplerUses(defs, sampledTypeId);
+            if (!uses.safe) {
+                continue;
+            }
+
+            std::unordered_map<uint32_t, uint32_t> pointerTypes;
+            defs->ForEachUser(sampledTypeId, [&](Instruction* user) {
+                if (user->opcode() != spv::Op::OpTypePointer ||
+                    user->GetSingleWordInOperand(1) != sampledTypeId) {
+                    return;
+                }
+                const auto storage = static_cast<spv::StorageClass>(
+                    user->GetSingleWordInOperand(0));
+                const uint32_t replacementId = types->FindPointerToType(imageTypeId, storage);
+                // TypeManager appends a newly-created type to types_values. That can put
+                // it after global variables, which violates SPIR-V logical layout. Move
+                // it to the end of the type section before serializing the module.
+                if (firstGlobalVariable != nullptr) {
+                    defs->GetDef(replacementId)->InsertBefore(firstGlobalVariable);
+                }
+                pointerTypes.emplace(user->result_id(), replacementId);
+            });
+
+            // Retype every variable whose pointer used to point at the combined image.
+            // Do this before loads so the module remains internally consistent after the
+            // pass and can be validated independently of Tint.
+            ctx->module()->ForEachInst([&](Instruction* inst) {
+                if (inst->opcode() != spv::Op::OpVariable) {
+                    return;
+                }
+                const auto replacement = pointerTypes.find(inst->type_id());
+                if (replacement == pointerTypes.end()) {
+                    return;
+                }
+                inst->SetResultType(replacement->second);
+                ctx->UpdateDefUse(inst);
+            });
+
+            for (Instruction* load : uses.loads) {
+                load->SetResultType(imageTypeId);
+                ctx->UpdateDefUse(load);
+            }
+
+            // OpImage only unwraps OpTypeSampledImage. The load now already yields the
+            // plain image, so redirect every fetch to it and erase the wrapper.
+            for (Instruction* image : uses.imageExtracts) {
+                const uint32_t plainImageId = image->GetSingleWordInOperand(0);
+                std::vector<Instruction*> imageUsers;
+                defs->ForEachUser(image->result_id(),
+                                  [&](Instruction* user) { imageUsers.push_back(user); });
+                ctx->ReplaceAllUsesWith(image->result_id(), plainImageId);
+                for (Instruction* user : imageUsers) {
+                    FoldFetchConstOffset(ctx, user);
+                }
+                ctx->KillNamesAndDecorates(image->result_id());
+                ctx->KillInst(image);
+            }
+            modified = true;
+        }
+
+        return modified ? Status::SuccessWithChange : Status::SuccessWithoutChange;
+    }
+
+    spvtools::Optimizer::PassToken
+    LegalizeIntegerTexelFetchPass::CreateLegalizeIntegerTexelFetchPass() {
+        return spvtools::Optimizer::PassToken(
+            spvtools::MakeUnique<LegalizeIntegerTexelFetchPass>());
+    }
+} // namespace MobileGL::MG_Util::ShaderTranspiler

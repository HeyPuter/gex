+            case GL_FRAMEBUFFER_ATTACHMENT_RED_SIZE: *params = sizes.Red; return;
+            case GL_FRAMEBUFFER_ATTACHMENT_GREEN_SIZE: *params = sizes.Green; return;
+            case GL_FRAMEBUFFER_ATTACHMENT_BLUE_SIZE: *params = sizes.Blue; return;
+            case GL_FRAMEBUFFER_ATTACHMENT_ALPHA_SIZE: *params = sizes.Alpha; return;
+            case GL_FRAMEBUFFER_ATTACHMENT_DEPTH_SIZE: *params = sizes.Depth; return;
+            case GL_FRAMEBUFFER_ATTACHMENT_STENCIL_SIZE: *params = sizes.Stencil; return;

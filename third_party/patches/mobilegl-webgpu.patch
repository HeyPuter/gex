diff --git a/MobileGL/MG_Util/Texture/S3tcDecoder.cpp b/MobileGL/MG_Util/Texture/S3tcDecoder.cpp
new file mode 100644
index 00000000..d73dfb68
--- /dev/null
+++ b/MobileGL/MG_Util/Texture/S3tcDecoder.cpp
@@ -0,0 +1,121 @@
+// MobileGL - software S3TC fallback used when the backend cannot accept BC data.
+#include "S3tcDecoder.h"
+
+#include <limits>
+#include <new>
+
+namespace MobileGL::MG_Util::S3tcDecoder {
+    namespace {
+        Uint16 ReadLe16(const Uint8* data) {
+            return static_cast<Uint16>(data[0]) | (static_cast<Uint16>(data[1]) << 8);
+        }
+
+        Uint32 ReadLe32(const Uint8* data) {
+            return static_cast<Uint32>(data[0]) | (static_cast<Uint32>(data[1]) << 8) |
+                   (static_cast<Uint32>(data[2]) << 16) | (static_cast<Uint32>(data[3]) << 24);
+        }
+
+        Uint8 Expand5(Uint value) { return static_cast<Uint8>((value * 255u + 15u) / 31u); }
+        Uint8 Expand6(Uint value) { return static_cast<Uint8>((value * 255u + 31u) / 63u); }
+
+        void DecodeBc3Block(const Uint8* block, Uint8 rgba[16][4]) {
+            Uint8 alpha[8] = {block[0], block[1]};
+            if (alpha[0] > alpha[1]) {
+                for (Uint i = 1; i <= 6; ++i) {
+                    alpha[i + 1] = static_cast<Uint8>(((7u - i) * alpha[0] + i * alpha[1]) / 7u);
+                }
+            } else {
+                for (Uint i = 1; i <= 4; ++i) {
+                    alpha[i + 1] = static_cast<Uint8>(((5u - i) * alpha[0] + i * alpha[1]) / 5u);
+                }
+                alpha[6] = 0;
+                alpha[7] = 255;
+            }
+
+            Uint64 alphaIndices = 0;
+            for (Uint i = 0; i < 6; ++i) {
+                alphaIndices |= static_cast<Uint64>(block[2 + i]) << (8u * i);
+            }
+
+            const Uint16 color0 = ReadLe16(block + 8);
+            const Uint16 color1 = ReadLe16(block + 10);
+            Uint8 color[4][3] = {
+                {Expand5((color0 >> 11) & 31u), Expand6((color0 >> 5) & 63u), Expand5(color0 & 31u)},
+                {Expand5((color1 >> 11) & 31u), Expand6((color1 >> 5) & 63u), Expand5(color1 & 31u)},
+            };
+            // BC3 always uses the four-color BC1 mode, even when color0 <= color1.
+            for (Uint channel = 0; channel < 3; ++channel) {
+                color[2][channel] = static_cast<Uint8>((2u * color[0][channel] + color[1][channel]) / 3u);
+                color[3][channel] = static_cast<Uint8>((color[0][channel] + 2u * color[1][channel]) / 3u);
+            }
+
+            const Uint32 colorIndices = ReadLe32(block + 12);
+            for (Uint pixel = 0; pixel < 16; ++pixel) {
+                const Uint colorIndex = (colorIndices >> (2u * pixel)) & 3u;
+                rgba[pixel][0] = color[colorIndex][0];
+                rgba[pixel][1] = color[colorIndex][1];
+                rgba[pixel][2] = color[colorIndex][2];
+                rgba[pixel][3] = alpha[(alphaIndices >> (3u * pixel)) & 7u];
+            }
+        }
+    } // namespace
+
+    Result Decode2D(GLenum compressedFormat, GLsizei width, GLsizei height,
+                    const void* input, SizeT inputSize, Vector<Uint8>& output,
+                    GLenum& storageInternalFormat, SizeT& requiredInputSize) {
+        output.clear();
+        requiredInputSize = 0;
+        switch (compressedFormat) {
+        case GL_COMPRESSED_RGBA_S3TC_DXT5_EXT:
+            storageInternalFormat = GL_RGBA8;
+            break;
+        case GL_COMPRESSED_SRGB_ALPHA_S3TC_DXT5_EXT:
+            storageInternalFormat = GL_SRGB8_ALPHA8;
+            break;
+        default:
+            return Result::UnsupportedFormat;
+        }
+        if (width < 0 || height < 0) return Result::InvalidInput;
+
+        const SizeT blockWidth = (static_cast<SizeT>(width) + 3u) / 4u;
+        const SizeT blockHeight = (static_cast<SizeT>(height) + 3u) / 4u;
+        if (blockWidth != 0 && blockHeight > std::numeric_limits<SizeT>::max() / blockWidth) {
+            return Result::InvalidInput;
+        }
+        const SizeT blockCount = blockWidth * blockHeight;
+        if (blockCount > std::numeric_limits<SizeT>::max() / 16u) return Result::InvalidInput;
+        requiredInputSize = blockCount * 16u;
+        if (inputSize < requiredInputSize) return Result::InputTooSmall;
+        if (requiredInputSize != 0 && input == nullptr) return Result::InvalidInput;
+
+        const SizeT pixelCount = static_cast<SizeT>(width) * static_cast<SizeT>(height);
+        if (width != 0 && pixelCount / static_cast<SizeT>(width) != static_cast<SizeT>(height)) {
+            return Result::InvalidInput;
+        }
+        if (pixelCount > std::numeric_limits<SizeT>::max() / 4u) return Result::InvalidInput;
+        try {
+            output.assign(pixelCount * 4u, 0);
+        } catch (const std::bad_alloc&) {
+            return Result::OutOfMemory;
+        }
+
+        const auto* blocks = static_cast<const Uint8*>(input);
+        for (SizeT blockY = 0; blockY < blockHeight; ++blockY) {
+            for (SizeT blockX = 0; blockX < blockWidth; ++blockX) {
+                Uint8 decoded[16][4];
+                DecodeBc3Block(blocks + (blockY * blockWidth + blockX) * 16u, decoded);
+                for (SizeT localY = 0; localY < 4; ++localY) {
+                    const SizeT y = blockY * 4u + localY;
+                    if (y >= static_cast<SizeT>(height)) break;
+                    for (SizeT localX = 0; localX < 4; ++localX) {
+                        const SizeT x = blockX * 4u + localX;
+                        if (x >= static_cast<SizeT>(width)) break;
+                        Memcpy(output.data() + (y * static_cast<SizeT>(width) + x) * 4u,
+                               decoded[localY * 4u + localX], 4u);
+                    }
+                }
+            }
+        }
+        return Result::Completed;
+    }
+} // namespace MobileGL::MG_Util::S3tcDecoder

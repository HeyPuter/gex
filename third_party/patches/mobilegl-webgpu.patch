+            std::optional<InterfaceVariable> SpvcSession::GetShaderBuiltin(
+                spvc_builtin_resource_type resource_type, SpvBuiltIn builtin) const {
+                auto makeVariable = [builtin](const SpvcType& type) {
+                    InterfaceVariable variable;
+                    variable.name = builtin == SpvBuiltInPosition ? "gl_Position" : "";
+                    variable.location = UINT32_MAX;
+                    variable.type = type;
+                    return variable;
+                };
+                if (usage & SessionUsageBit::Transpile) {
+                    const spvc_reflected_builtin_resource* list = nullptr;
+                    size_t count = 0;
+                    if (spvc_resources_get_builtin_resource_list_for_type(
+                            resources, resource_type, &list, &count) != SPVC_SUCCESS) return std::nullopt;
+                    for (size_t i = 0; i < count; ++i) {
+                        if (list[i].builtin != builtin) continue;
+                        const spvc_type type = spvc_compiler_get_type_handle(compiler, list[i].value_type_id);
+                        SpvcType valueType;
+                        valueType.basetype = spvc_type_get_basetype(type);
+                        valueType.vectorSize = spvc_type_get_vector_size(type);
+                        valueType.matCol = spvc_type_get_columns(type);
+                        return makeVariable(valueType);
+                    }
+                    return std::nullopt;
+                }
+                if (!reflectModuleValid) return std::nullopt;
+                uint32_t count = 0;
+                const bool output = resource_type == SPVC_BUILTIN_RESOURCE_TYPE_STAGE_OUTPUT;
+                if (output) spvReflectEnumerateOutputVariables(&reflectModule, &count, nullptr);
+                else spvReflectEnumerateInputVariables(&reflectModule, &count, nullptr);
+                Vector<SpvReflectInterfaceVariable*> variables(count);
+                if (output) spvReflectEnumerateOutputVariables(&reflectModule, &count, variables.data());
+                else spvReflectEnumerateInputVariables(&reflectModule, &count, variables.data());
+                const auto findBuiltin = [&](const auto& self, const SpvReflectInterfaceVariable& variable)
+                    -> const SpvReflectInterfaceVariable* {
+                    if (variable.built_in == static_cast<int>(builtin)) return &variable;
+                    for (uint32_t i = 0; i < variable.member_count; ++i) {
+                        if (const auto* found = self(self, variable.members[i])) return found;
+                    }
+                    return nullptr;
+                };
+                for (const auto* variable : variables) {
+                    if (!variable) continue;
+                    if (const auto* found = findBuiltin(findBuiltin, *variable))
+                        return makeVariable(MapReflectInterfaceType(*found));
+                }
+                return std::nullopt;
+            }

diff --git a/tools/native_harness/instanced_packed_fixture.cpp b/tools/native_harness/instanced_packed_fixture.cpp
new file mode 100644
index 00000000..5f636241
--- /dev/null
+++ b/tools/native_harness/instanced_packed_fixture.cpp
@@ -0,0 +1,224 @@
+// Minimal desktop-GL regression for STK-style interleaved packed vertices and
+// per-instance attributes. Capture under Mesa and replay through MobileGL.
+
+#include <GL/glew.h>
+#include <GLFW/glfw3.h>
+
+#include <array>
+#include <cstdint>
+#include <cstdio>
+#include <cstdlib>
+#include <string_view>
+
+namespace {
+
+[[noreturn]] void Fail(const char* message) {
+    std::fprintf(stderr, "instanced_packed_fixture: %s\n", message);
+    std::exit(1);
+}
+
+GLuint Compile(GLenum stage, const char* source) {
+    const GLuint shader = glCreateShader(stage);
+    glShaderSource(shader, 1, &source, nullptr);
+    glCompileShader(shader);
+    GLint ok = GL_FALSE;
+    glGetShaderiv(shader, GL_COMPILE_STATUS, &ok);
+    if (!ok) {
+        std::array<char, 4096> log{};
+        glGetShaderInfoLog(shader, static_cast<GLsizei>(log.size()), nullptr, log.data());
+        std::fprintf(stderr, "%s\n", log.data());
+        Fail("shader compilation failed");
+    }
+    return shader;
+}
+
+GLuint Link(GLuint vertex, GLuint fragment) {
+    const GLuint program = glCreateProgram();
+    glAttachShader(program, vertex);
+    glAttachShader(program, fragment);
+    glLinkProgram(program);
+    GLint ok = GL_FALSE;
+    glGetProgramiv(program, GL_LINK_STATUS, &ok);
+    if (!ok) Fail("program link failed");
+    return program;
+}
+
+bool HasArgument(int argc, char** argv, std::string_view value) {
+    for (int i = 1; i < argc; ++i) {
+        if (argv[i] == value) return true;
+    }
+    return false;
+}
+
+struct Vertex {
+    float position[3];
+    std::uint32_t normal;
+    std::uint8_t color[4];
+    std::uint16_t uv[2];
+};
+static_assert(sizeof(Vertex) == 24);
+
+struct Instance {
+    float origin[3];
+    float rotation[4];
+    std::uint16_t scale[4];
+    std::int16_t textureTranslation[2];
+    std::int16_t misc[2];
+};
+static_assert(sizeof(Instance) == 44);
+
+} // namespace
+
+int main(int argc, char** argv) {
+    const bool minimalInputs = HasArgument(argc, argv, "--minimal-inputs");
+    const bool noInstanceInputs = HasArgument(argc, argv, "--no-instance-inputs");
+    const bool originOnly = HasArgument(argc, argv, "--origin-only");
+    if (!glfwInit()) Fail("glfwInit failed");
+    glfwWindowHint(GLFW_CONTEXT_VERSION_MAJOR, 4);
+    glfwWindowHint(GLFW_CONTEXT_VERSION_MINOR, 4);
+    glfwWindowHint(GLFW_OPENGL_PROFILE, GLFW_OPENGL_CORE_PROFILE);
+    glfwWindowHint(GLFW_RESIZABLE, GLFW_FALSE);
+    GLFWwindow* window = glfwCreateWindow(960, 540, "MobileGL instanced packed fixture", nullptr, nullptr);
+    if (!window) Fail("window creation failed");
+    glfwMakeContextCurrent(window);
+    glewExperimental = GL_TRUE;
+    if (glewInit() != GLEW_OK) Fail("GLEW initialization failed");
+    while (glGetError() != GL_NO_ERROR) {}
+
+    const char* fullVertexSource = R"GLSL(
+#version 440 core
+layout(location=0) in vec3 i_position;
+layout(location=1) in vec4 i_normal;
+layout(location=2) in vec4 i_color;
+layout(location=3) in vec2 i_uv;
+layout(location=8) in vec3 i_origin;
+layout(location=9) in vec4 i_rotation;
+layout(location=10) in vec4 i_scale;
+layout(location=11) in vec2 i_texture_trans;
+layout(location=12) in ivec2 i_misc_data;
+out vec4 color;
+void main() {
+    vec3 position = i_position * i_scale.xyz + i_origin;
+    gl_Position = vec4(position, 1.0);
+    color = vec4(abs(i_normal.xyz), 1.0) * i_color.zyxw;
+    color.rgb += vec3(i_uv + i_texture_trans, float(i_misc_data.x)) * 0.0;
+    color.rgb += i_rotation.xyz * 0.0;
+}
+)GLSL";
+    const char* minimalVertexSource = R"GLSL(
+#version 440 core
+layout(location=0) in vec3 i_position;
+layout(location=8) in vec3 i_origin;
+layout(location=10) in vec4 i_scale;
+out vec4 color;
+void main() {
+    gl_Position = vec4(i_position * i_scale.xyz + i_origin, 1.0);
+    color = vec4(0.2, 0.7, 1.0, 1.0);
+}
+)GLSL";
+    const char* noInstanceVertexSource = R"GLSL(
+#version 440 core
+layout(location=0) in vec3 i_position;
+out vec4 color;
+void main() {
+    gl_Position = vec4(i_position, 1.0);
+    color = vec4(1.0, 0.3, 0.2, 1.0);
+}
+)GLSL";
+    const char* fragmentSource = R"GLSL(
+#version 440 core
+in vec4 color;
+layout(location=0) out vec4 outputColor;
+void main() { outputColor = color; }
+)GLSL";
+    const char* originVertexSource = R"GLSL(
+#version 440 core
+layout(location=0) in vec3 i_position;
+layout(location=8) in vec3 i_origin;
+out vec4 color;
+void main() {
+    gl_Position = vec4(i_position * 0.3 + i_origin, 1.0);
+    color = vec4(0.3, 1.0, 0.4, 1.0);
+}
+)GLSL";
+    const char* selectedVertexSource = noInstanceInputs ? noInstanceVertexSource
+                                       : originOnly ? originVertexSource
+                                                    : (minimalInputs ? minimalVertexSource : fullVertexSource);
+    const GLuint program = Link(Compile(GL_VERTEX_SHADER, selectedVertexSource),
+                                Compile(GL_FRAGMENT_SHADER, fragmentSource));
+
+    constexpr std::uint32_t packedPositiveZ = 0x1ff00000u;
+    constexpr std::array<Vertex, 4> vertices{{
+        {{-0.12f, -0.18f, 0.0f}, packedPositiveZ, {255, 160, 80, 255}, {0, 0}},
+        {{ 0.12f, -0.18f, 0.0f}, packedPositiveZ, {255, 160, 80, 255}, {0, 0}},
+        {{ 0.12f,  0.18f, 0.0f}, packedPositiveZ, {255, 160, 80, 255}, {0, 0}},
+        {{-0.12f,  0.18f, 0.0f}, packedPositiveZ, {255, 160, 80, 255}, {0, 0}},
+    }};
+    constexpr std::array<std::uint16_t, 6> indices{{0, 1, 2, 0, 2, 3}};
+    // 0x3c00 is half-float 1.0. Quaternion w=1 and the remaining
+    // fields are intentionally present to exercise STK's 44-byte stride.
+    constexpr std::array<Instance, 3> instances{{
+        {{-0.55f, 0.0f, 0.0f}, {0, 0, 0, 1}, {0x3c00, 0x3c00, 0x3c00, 0x3c00}, {0, 0}, {0, 0}},
+        {{ 0.00f, 0.0f, 0.0f}, {0, 0, 0, 1}, {0x3c00, 0x3c00, 0x3c00, 0x3c00}, {0, 0}, {0, 0}},
+        {{ 0.55f, 0.0f, 0.0f}, {0, 0, 0, 1}, {0x3c00, 0x3c00, 0x3c00, 0x3c00}, {0, 0}, {0, 0}},
+    }};
+
+    GLuint vao = 0, vertexBuffer = 0, indexBuffer = 0, instanceBuffer = 0;
+    glGenVertexArrays(1, &vao);
+    glBindVertexArray(vao);
+    glGenBuffers(1, &vertexBuffer);
+    glBindBuffer(GL_ARRAY_BUFFER, vertexBuffer);
+    glBufferData(GL_ARRAY_BUFFER, sizeof(vertices), vertices.data(), GL_DYNAMIC_DRAW);
+    glEnableVertexAttribArray(0);
+    glVertexAttribPointer(0, 3, GL_FLOAT, GL_FALSE, sizeof(Vertex), reinterpret_cast<void*>(0));
+    if (!minimalInputs) {
+        glEnableVertexAttribArray(1);
+        glVertexAttribPointer(1, 4, GL_INT_2_10_10_10_REV, GL_TRUE, sizeof(Vertex), reinterpret_cast<void*>(12));
+        glEnableVertexAttribArray(2);
+        glVertexAttribPointer(2, 4, GL_UNSIGNED_BYTE, GL_TRUE, sizeof(Vertex), reinterpret_cast<void*>(16));
+        glEnableVertexAttribArray(3);
+        glVertexAttribPointer(3, 2, GL_HALF_FLOAT, GL_FALSE, sizeof(Vertex), reinterpret_cast<void*>(20));
+    }
+    glGenBuffers(1, &indexBuffer);
+    glBindBuffer(GL_ELEMENT_ARRAY_BUFFER, indexBuffer);
+    glBufferData(GL_ELEMENT_ARRAY_BUFFER, sizeof(indices), indices.data(), GL_STATIC_DRAW);
+
+    glGenBuffers(1, &instanceBuffer);
+    glBindBuffer(GL_ARRAY_BUFFER, instanceBuffer);
+    glBufferData(GL_ARRAY_BUFFER, sizeof(instances), instances.data(), GL_DYNAMIC_DRAW);
+    if (!noInstanceInputs) {
+        glEnableVertexAttribArray(8);
+        glVertexAttribPointer(8, 3, GL_FLOAT, GL_FALSE, sizeof(Instance), reinterpret_cast<void*>(0));
+        glVertexAttribDivisor(8, 1);
+    }
+    if (!noInstanceInputs && !originOnly) {
+        glEnableVertexAttribArray(10);
+        glVertexAttribPointer(10, 4, GL_HALF_FLOAT, GL_FALSE, sizeof(Instance), reinterpret_cast<void*>(28));
+        glVertexAttribDivisor(10, 1);
+    }
+    if (!minimalInputs && !noInstanceInputs && !originOnly) {
+        glEnableVertexAttribArray(9);
+        glVertexAttribPointer(9, 4, GL_FLOAT, GL_FALSE, sizeof(Instance), reinterpret_cast<void*>(12));
+        glEnableVertexAttribArray(11);
+        glVertexAttribPointer(11, 2, GL_SHORT, GL_TRUE, sizeof(Instance), reinterpret_cast<void*>(36));
+        glEnableVertexAttribArray(12);
+        glVertexAttribIPointer(12, 2, GL_SHORT, sizeof(Instance), reinterpret_cast<void*>(40));
+        glVertexAttribDivisor(9, 1);
+        glVertexAttribDivisor(11, 1);
+        glVertexAttribDivisor(12, 1);
+    }
+
+    glViewport(0, 0, 960, 540);
+    glClearColor(0.12f, 0.16f, 0.22f, 1.0f);
+    glClear(GL_COLOR_BUFFER_BIT | GL_DEPTH_BUFFER_BIT);
+    glUseProgram(program);
+    glDrawElementsInstanced(GL_TRIANGLES, static_cast<GLsizei>(indices.size()), GL_UNSIGNED_SHORT, nullptr,
+                            static_cast<GLsizei>(instances.size()));
+    glFinish();
+    glfwSwapBuffers(window);
+    const GLenum error = glGetError();
+    std::printf("fixture_error=0x%04x\n", error);
+    glfwDestroyWindow(window);
+    glfwTerminate();
+    return error == GL_NO_ERROR ? 0 : 2;
+}

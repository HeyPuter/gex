+    WGPURenderPipeline WebGPURenderer::GetOrCreateDepthReadbackPipeline(WGPUTextureFormat sourceFormat) {
+        const Uint32 key = static_cast<Uint32>(sourceFormat);
+        if (auto it = m_depthReadbackPipelines.find(key); it != m_depthReadbackPipelines.end()) return it->second;
+        static const char* source =
+            "@group(0) @binding(0) var src : texture_depth_2d;\n"
+            "@vertex fn vs(@builtin(vertex_index) i:u32)->@builtin(position) vec4f { let x=f32((i<<1u)&2u); let y=f32(i&2u); return vec4f(x*2.0-1.0,1.0-y*2.0,0.0,1.0); }\n"
+            "@fragment fn fs(@builtin(position) p:vec4f)->@location(0) f32 { return textureLoad(src,vec2i(p.xy),0); }\n";
+        WGPUShaderModule module = MakeShaderModule(source);
+        if (!module) return nullptr;
+        WGPUColorTargetState target{};
+        target.format = WGPUTextureFormat_R32Float;
+        target.writeMask = WGPUColorWriteMask_Red;
+        WGPUFragmentState fragment{};
+        fragment.module = module;
+        fragment.entryPoint = Wgpu::View("fs");
+        fragment.targetCount = 1;
+        fragment.targets = &target;
+        WGPURenderPipelineDescriptor desc{};
+        desc.vertex.module = module;
+        desc.vertex.entryPoint = Wgpu::View("vs");
+        desc.primitive.topology = WGPUPrimitiveTopology_TriangleList;
+        desc.multisample.count = 1;
+        desc.multisample.mask = 0xFFFFFFFFu;
+        desc.fragment = &fragment;
+        WGPURenderPipeline pipeline = wgpuDeviceCreateRenderPipeline(m_device, &desc);
+        wgpuShaderModuleRelease(module);
+        m_depthReadbackPipelines.emplace(key, pipeline);
+        return pipeline;
+    }
+
+    WGPURenderPipeline WebGPURenderer::GetOrCreateStencilExtractPipeline(
+        WGPUTextureFormat format, Uint32 samples, Uint32 bit) {
+        const Uint64 key = static_cast<Uint64>(static_cast<Uint32>(format)) |
+                           (static_cast<Uint64>(samples) << 32) |
+                           (static_cast<Uint64>(bit) << 40);
+        if (auto it = m_stencilExtractPipelines.find(key); it != m_stencilExtractPipelines.end()) return it->second;
+        const std::string source = std::format(
+            "@vertex fn vs(@builtin(vertex_index) i:u32)->@builtin(position) vec4f {{ let x=f32((i<<1u)&2u); let y=f32(i&2u); return vec4f(x*2.0-1.0,1.0-y*2.0,0.0,1.0); }}\n"
+            "@fragment fn fs()->@location(0) f32 {{ return {:.9f}; }}\n", static_cast<double>(bit) / 255.0);
+        WGPUShaderModule module = MakeShaderModule(source.c_str());
+        if (!module) return nullptr;
+        WGPUBlendState blend{};
+        blend.color = {WGPUBlendOperation_Add, WGPUBlendFactor_One, WGPUBlendFactor_One};
+        blend.alpha = blend.color;
+        WGPUColorTargetState target{};
+        target.format = WGPUTextureFormat_R8Unorm;
+        target.blend = &blend;
+        target.writeMask = WGPUColorWriteMask_Red;
+        WGPUFragmentState fragment{};
+        fragment.module = module;
+        fragment.entryPoint = Wgpu::View("fs");
+        fragment.targetCount = 1;
+        fragment.targets = &target;
+        WGPUDepthStencilState depth{};
+        depth.format = format;
+        depth.depthWriteEnabled = WGPUOptionalBool_False;
+        depth.depthCompare = WGPUCompareFunction_Always;
+        depth.stencilFront = {WGPUCompareFunction_Equal, WGPUStencilOperation_Keep,
+                              WGPUStencilOperation_Keep, WGPUStencilOperation_Keep};
+        depth.stencilBack = depth.stencilFront;
+        depth.stencilReadMask = bit;
+        depth.stencilWriteMask = 0u;
+        WGPURenderPipelineDescriptor desc{};
+        desc.vertex.module = module;
+        desc.vertex.entryPoint = Wgpu::View("vs");
+        desc.primitive.topology = WGPUPrimitiveTopology_TriangleList;
+        desc.multisample.count = samples;
+        // Emit the encoded stencil bit to every covered sample. Restricting
+        // this to sample zero makes the fixed-function color resolve divide
+        // small R8 values by the sample count and quantize low stencil bits
+        // to zero.
+        desc.multisample.mask = 0xFFFFFFFFu;
+        desc.fragment = &fragment;
+        desc.depthStencil = &depth;
+        WGPURenderPipeline pipeline = wgpuDeviceCreateRenderPipeline(m_device, &desc);
+        wgpuShaderModuleRelease(module);
+        m_stencilExtractPipelines.emplace(key, pipeline);
+        return pipeline;
+    }
+
+    WGPURenderPipeline WebGPURenderer::GetOrCreateStencilWritePipeline(
+        WGPUTextureFormat format, Uint32 sourceSamples, Uint32 bit) {
+        const Uint64 key = static_cast<Uint64>(static_cast<Uint32>(format)) |
+                           (static_cast<Uint64>(sourceSamples) << 32) |
+                           (static_cast<Uint64>(bit) << 40);
+        if (auto it = m_stencilWritePipelines.find(key); it != m_stencilWritePipelines.end()) return it->second;
+        const std::string source = std::format(
+            "@group(0) @binding(0) var mask:texture_2d<f32>;\n"
+            "struct Params {{ map: vec4f }}; @group(0) @binding(1) var<uniform> params:Params;\n"
+            "@vertex fn vs(@builtin(vertex_index) i:u32)->@builtin(position) vec4f {{ let x=f32((i<<1u)&2u); let y=f32(i&2u); return vec4f(x*2.0-1.0,1.0-y*2.0,0.0,1.0); }}\n"
+            "@fragment fn fs(@builtin(position) p:vec4f) {{ let q=vec2i(params.map.xy+p.xy*params.map.zw); let v=u32(round(textureLoad(mask,q,0).r*255.0)); if ((v & {}u)==0u) {{ discard; }} }}\n",
+            bit);
+        WGPUShaderModule module = MakeShaderModule(source.c_str());
+        if (!module) return nullptr;
+        WGPUFragmentState fragment{};
+        fragment.module = module;
+        fragment.entryPoint = Wgpu::View("fs");
+        WGPUDepthStencilState depth{};
+        depth.format = format;
+        depth.depthWriteEnabled = WGPUOptionalBool_False;
+        depth.depthCompare = WGPUCompareFunction_Always;
+        depth.stencilFront = {WGPUCompareFunction_Always, WGPUStencilOperation_Keep,
+                              WGPUStencilOperation_Keep, WGPUStencilOperation_Replace};
+        depth.stencilBack = depth.stencilFront;
+        depth.stencilReadMask = 0xFFFFFFFFu;
+        depth.stencilWriteMask = bit;
+        WGPURenderPipelineDescriptor desc{};
+        desc.vertex.module = module;
+        desc.vertex.entryPoint = Wgpu::View("vs");
+        desc.primitive.topology = WGPUPrimitiveTopology_TriangleList;
+        desc.multisample.count = 1;
+        desc.multisample.mask = 0xFFFFFFFFu;
+        desc.fragment = &fragment;
+        desc.depthStencil = &depth;
+        WGPURenderPipeline pipeline = wgpuDeviceCreateRenderPipeline(m_device, &desc);
+        wgpuShaderModuleRelease(module);
+        m_stencilWritePipelines.emplace(key, pipeline);
+        return pipeline;
+    }

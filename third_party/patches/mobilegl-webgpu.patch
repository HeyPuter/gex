diff --git a/tools/native_harness/cubemap_fixture.cpp b/tools/native_harness/cubemap_fixture.cpp
new file mode 100644
index 00000000..d2c63f76
--- /dev/null
+++ b/tools/native_harness/cubemap_fixture.cpp
@@ -0,0 +1,133 @@
+// Differential cubemap face/orientation fixture for desktop GL backends.
+
+#include <GL/glew.h>
+#include <GLFW/glfw3.h>
+
+#include <array>
+#include <cstdint>
+#include <cstdio>
+#include <cstdlib>
+#include <vector>
+
+namespace {
+[[noreturn]] void Fail(const char* message) {
+    std::fprintf(stderr, "cubemap_fixture: %s\n", message);
+    std::exit(1);
+}
+
+GLuint Compile(GLenum stage, const char* source) {
+    GLuint shader = glCreateShader(stage);
+    glShaderSource(shader, 1, &source, nullptr);
+    glCompileShader(shader);
+    GLint ok = GL_FALSE;
+    glGetShaderiv(shader, GL_COMPILE_STATUS, &ok);
+    if (!ok) {
+        std::array<char, 4096> log{};
+        glGetShaderInfoLog(shader, static_cast<GLsizei>(log.size()), nullptr, log.data());
+        std::fprintf(stderr, "%s\n", log.data());
+        Fail("shader compilation failed");
+    }
+    return shader;
+}
+
+GLuint Link(GLuint vertex, GLuint fragment) {
+    GLuint program = glCreateProgram();
+    glAttachShader(program, vertex);
+    glAttachShader(program, fragment);
+    glLinkProgram(program);
+    GLint ok = GL_FALSE;
+    glGetProgramiv(program, GL_LINK_STATUS, &ok);
+    if (!ok) Fail("program link failed");
+    return program;
+}
+} // namespace
+
+int main() {
+    if (!glfwInit()) Fail("glfwInit failed");
+    glfwWindowHint(GLFW_CONTEXT_VERSION_MAJOR, 4);
+    glfwWindowHint(GLFW_CONTEXT_VERSION_MINOR, 4);
+    glfwWindowHint(GLFW_OPENGL_PROFILE, GLFW_OPENGL_CORE_PROFILE);
+    glfwWindowHint(GLFW_RESIZABLE, GLFW_FALSE);
+    GLFWwindow* window = glfwCreateWindow(960, 540, "MobileGL cubemap fixture", nullptr, nullptr);
+    if (!window) Fail("window creation failed");
+    glfwMakeContextCurrent(window);
+    glewExperimental = GL_TRUE;
+    if (glewInit() != GLEW_OK) Fail("GLEW initialization failed");
+    while (glGetError() != GL_NO_ERROR) {}
+
+    const char* vertexSource = R"GLSL(
+#version 440 core
+out vec2 uv;
+void main() {
+    vec2 p = vec2((gl_VertexID << 1) & 2, gl_VertexID & 2);
+    uv = p;
+    gl_Position = vec4(p * 2.0 - 1.0, 0.0, 1.0);
+}
+)GLSL";
+    const char* fragmentSource = R"GLSL(
+#version 440 core
+uniform samplerCube cubeTexture;
+in vec2 uv;
+layout(location=0) out vec4 outputColor;
+void main() {
+    float panelValue = clamp(floor(uv.x * 6.0), 0.0, 5.0);
+    int panel = int(panelValue);
+    vec2 local = vec2(fract(uv.x * 6.0), uv.y) * 2.0 - 1.0;
+    vec3 direction;
+    if (panel == 0) direction = vec3( 1.0, -local.y, -local.x);
+    else if (panel == 1) direction = vec3(-1.0, -local.y,  local.x);
+    else if (panel == 2) direction = vec3( local.x,  1.0,  local.y);
+    else if (panel == 3) direction = vec3( local.x, -1.0, -local.y);
+    else if (panel == 4) direction = vec3( local.x, -local.y,  1.0);
+    else direction = vec3(-local.x, -local.y, -1.0);
+    outputColor = texture(cubeTexture, direction);
+}
+)GLSL";
+    const GLuint program = Link(Compile(GL_VERTEX_SHADER, vertexSource),
+                                Compile(GL_FRAGMENT_SHADER, fragmentSource));
+
+    constexpr int size = 32;
+    constexpr std::array<GLenum, 6> faces{{
+        GL_TEXTURE_CUBE_MAP_POSITIVE_X, GL_TEXTURE_CUBE_MAP_NEGATIVE_X,
+        GL_TEXTURE_CUBE_MAP_POSITIVE_Y, GL_TEXTURE_CUBE_MAP_NEGATIVE_Y,
+        GL_TEXTURE_CUBE_MAP_POSITIVE_Z, GL_TEXTURE_CUBE_MAP_NEGATIVE_Z,
+    }};
+    GLuint texture = 0;
+    glGenTextures(1, &texture);
+    glBindTexture(GL_TEXTURE_CUBE_MAP, texture);
+    for (int face = 0; face < 6; ++face) {
+        std::vector<std::uint8_t> pixels(size * size * 4);
+        for (int y = 0; y < size; ++y) {
+            for (int x = 0; x < size; ++x) {
+                const std::size_t offset = static_cast<std::size_t>(y * size + x) * 4;
+                pixels[offset + 0] = static_cast<std::uint8_t>(face * 38 + x);
+                pixels[offset + 1] = static_cast<std::uint8_t>(32 + y * 6);
+                pixels[offset + 2] = static_cast<std::uint8_t>(240 - face * 31);
+                pixels[offset + 3] = 255;
+            }
+        }
+        glTexImage2D(faces[face], 0, GL_RGBA8, size, size, 0, GL_RGBA, GL_UNSIGNED_BYTE, pixels.data());
+    }
+    glTexParameteri(GL_TEXTURE_CUBE_MAP, GL_TEXTURE_MIN_FILTER, GL_NEAREST);
+    glTexParameteri(GL_TEXTURE_CUBE_MAP, GL_TEXTURE_MAG_FILTER, GL_NEAREST);
+    glTexParameteri(GL_TEXTURE_CUBE_MAP, GL_TEXTURE_WRAP_S, GL_CLAMP_TO_EDGE);
+    glTexParameteri(GL_TEXTURE_CUBE_MAP, GL_TEXTURE_WRAP_T, GL_CLAMP_TO_EDGE);
+    glTexParameteri(GL_TEXTURE_CUBE_MAP, GL_TEXTURE_WRAP_R, GL_CLAMP_TO_EDGE);
+
+    GLuint vao = 0;
+    glGenVertexArrays(1, &vao);
+    glBindVertexArray(vao);
+    glViewport(0, 0, 960, 540);
+    glClearColor(0.05f, 0.06f, 0.08f, 1.0f);
+    glClear(GL_COLOR_BUFFER_BIT);
+    glUseProgram(program);
+    glUniform1i(glGetUniformLocation(program, "cubeTexture"), 0);
+    glDrawArrays(GL_TRIANGLES, 0, 3);
+    glFinish();
+    glfwSwapBuffers(window);
+    const GLenum error = glGetError();
+    std::printf("fixture_error=0x%04x\n", error);
+    glfwDestroyWindow(window);
+    glfwTerminate();
+    return error == GL_NO_ERROR ? 0 : 2;
+}
diff --git a/tools/native_harness/fragcoord_fixture.cpp b/tools/native_harness/fragcoord_fixture.cpp

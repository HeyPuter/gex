+        Uint32 FindFragCoordVariable(spvtools::opt::IRContext* context, Uint32* outVectorTypeId,
+                                     Uint32* outFloatTypeId) {
+            constexpr auto kDecorationBuiltIn = static_cast<Uint32>(spv::Decoration::BuiltIn);
+            constexpr auto kBuiltInFragCoord = static_cast<Uint32>(spv::BuiltIn::FragCoord);
+            for (auto& inst : context->module()->annotations()) {
+                if (inst.opcode() != spv::Op::OpDecorate || inst.NumInOperands() < 3 ||
+                    inst.GetSingleWordInOperand(1) != kDecorationBuiltIn ||
+                    inst.GetSingleWordInOperand(2) != kBuiltInFragCoord) {
+                    continue;
+                }
+
+                const Uint32 variableId = inst.GetSingleWordInOperand(0);
+                auto* variable = context->get_def_use_mgr()->GetDef(variableId);
+                if (!variable || variable->opcode() != spv::Op::OpVariable ||
+                    variable->GetSingleWordInOperand(0) != static_cast<Uint32>(spv::StorageClass::Input)) {
+                    continue;
+                }
+                auto* pointerType = context->get_def_use_mgr()->GetDef(variable->type_id());
+                if (!pointerType || pointerType->opcode() != spv::Op::OpTypePointer) continue;
+                const Uint32 vectorTypeId = pointerType->GetSingleWordInOperand(1);
+                Uint32 floatTypeId = 0;
+                if (!IsVec4Float32(context, vectorTypeId, &floatTypeId)) continue;
+                *outVectorTypeId = vectorTypeId;
+                *outFloatTypeId = floatTypeId;
+                return variableId;
+            }
+            return 0;
+        }
+
+        class GlFragCoordLowerLeftPass final : public spvtools::opt::Pass {
+        public:
+            const char* name() const override { return "gl-fragcoord-lower-left"; }
+
+            Status Process() override {
+                using namespace spvtools::opt;
+                Uint32 vectorTypeId = 0;
+                Uint32 floatTypeId = 0;
+                const Uint32 fragCoordId = FindFragCoordVariable(context(), &vectorTypeId, &floatTypeId);
+                if (fragCoordId == 0) return Status::SuccessWithoutChange;
+
+                auto* module = context()->module();
+                const Uint32 pushStructTypeId = module->TakeNextIdBound();
+                auto pushStructType = MakeUnique<Instruction>(
+                    context(), spv::Op::OpTypeStruct, 0, pushStructTypeId,
+                    std::initializer_list<Operand>{{SPV_OPERAND_TYPE_ID, {vectorTypeId}}});
+                auto* pushStructTypePtr = pushStructType.get();
+                context()->AddType(std::move(pushStructType));
+                context()->AnalyzeDefUse(pushStructTypePtr);
+
+                context()->AddAnnotationInst(MakeUnique<Instruction>(
+                    context(), spv::Op::OpDecorate, 0, 0,
+                    std::initializer_list<Operand>{
+                        {SPV_OPERAND_TYPE_ID, {pushStructTypeId}},
+                        {SPV_OPERAND_TYPE_DECORATION, {static_cast<Uint32>(spv::Decoration::Block)}}}));
+                context()->AddAnnotationInst(MakeUnique<Instruction>(
+                    context(), spv::Op::OpMemberDecorate, 0, 0,
+                    std::initializer_list<Operand>{
+                        {SPV_OPERAND_TYPE_ID, {pushStructTypeId}},
+                        {SPV_OPERAND_TYPE_LITERAL_INTEGER, {0}},
+                        {SPV_OPERAND_TYPE_DECORATION, {static_cast<Uint32>(spv::Decoration::Offset)}},
+                        {SPV_OPERAND_TYPE_LITERAL_INTEGER, {0}}}));
+
+                const Uint32 pushStructPtrTypeId = module->TakeNextIdBound();
+                auto pushStructPtrType = MakeUnique<Instruction>(
+                    context(), spv::Op::OpTypePointer, 0, pushStructPtrTypeId,
+                    std::initializer_list<Operand>{
+                        {SPV_OPERAND_TYPE_STORAGE_CLASS, {static_cast<Uint32>(spv::StorageClass::PushConstant)}},
+                        {SPV_OPERAND_TYPE_ID, {pushStructTypeId}}});
+                auto* pushStructPtrTypePtr = pushStructPtrType.get();
+                context()->AddType(std::move(pushStructPtrType));
+                context()->AnalyzeDefUse(pushStructPtrTypePtr);
+
+                const Uint32 pushVectorPtrTypeId = module->TakeNextIdBound();
+                auto pushVectorPtrType = MakeUnique<Instruction>(
+                    context(), spv::Op::OpTypePointer, 0, pushVectorPtrTypeId,
+                    std::initializer_list<Operand>{
+                        {SPV_OPERAND_TYPE_STORAGE_CLASS, {static_cast<Uint32>(spv::StorageClass::PushConstant)}},
+                        {SPV_OPERAND_TYPE_ID, {vectorTypeId}}});
+                auto* pushVectorPtrTypePtr = pushVectorPtrType.get();
+                context()->AddType(std::move(pushVectorPtrType));
+                context()->AnalyzeDefUse(pushVectorPtrTypePtr);
+
+                const Uint32 pushVariableId = module->TakeNextIdBound();
+                auto pushVariable = MakeUnique<Instruction>(
+                    context(), spv::Op::OpVariable, pushStructPtrTypeId, pushVariableId,
+                    std::initializer_list<Operand>{{SPV_OPERAND_TYPE_STORAGE_CLASS,
+                                                    {static_cast<Uint32>(spv::StorageClass::PushConstant)}}});
+                auto* pushVariablePtr = pushVariable.get();
+                context()->AddGlobalValue(std::move(pushVariable));
+                context()->AnalyzeDefUse(pushVariablePtr);
+
+                const Uint32 functionVectorPtrTypeId =
+                    context()->get_type_mgr()->FindPointerToType(vectorTypeId, spv::StorageClass::Function);
+                const Uint32 memberZeroId = context()->get_constant_mgr()->GetUIntConstId(0);
+                if (functionVectorPtrTypeId == 0 || memberZeroId == 0) return Status::Failure;
+
+                Bool modified = false;
+                for (auto& entryPoint : module->entry_points()) {
+                    if (entryPoint.NumInOperands() < 2 ||
+                        static_cast<spv::ExecutionModel>(entryPoint.GetSingleWordInOperand(0)) !=
+                            spv::ExecutionModel::Fragment) {
+                        continue;
+                    }
+                    auto* function = context()->GetFunction(entryPoint.GetSingleWordInOperand(1));
+                    if (!function || function->begin() == function->end()) continue;
+                    auto* block = &*function->begin();
+                    Instruction* insertBefore = nullptr;
+                    for (auto& inst : *block) {
+                        if (inst.opcode() != spv::Op::OpVariable) {
+                            insertBefore = &inst;
+                            break;
+                        }
+                    }
+                    if (!insertBefore) continue;
+
+                    InstructionBuilder builder(context(), insertBefore,
+                        IRContext::kAnalysisDefUse | IRContext::kAnalysisInstrToBlockMapping);
+                    auto* correctedVariable = builder.AddVariable(
+                        functionVectorPtrTypeId, static_cast<Uint32>(spv::StorageClass::Function));
+                    if (!correctedVariable) return Status::Failure;
+
+                    // Redirect every pre-existing function use to the corrected local. The raw
+                    // FragCoord load is inserted afterwards and intentionally retains the builtin.
+                    for (auto& functionBlock : *function) {
+                        for (auto& inst : functionBlock) {
+                            inst.ForEachInId([&](Uint32* id) {
+                                if (*id == fragCoordId) *id = correctedVariable->result_id();
+                            });
+                        }
+                    }
+
+                    auto* raw = builder.AddLoad(vectorTypeId, fragCoordId);
+                    auto* x = raw ? builder.AddCompositeExtract(floatTypeId, raw->result_id(), {0}) : nullptr;
+                    auto* y = raw ? builder.AddCompositeExtract(floatTypeId, raw->result_id(), {1}) : nullptr;
+                    auto* z = raw ? builder.AddCompositeExtract(floatTypeId, raw->result_id(), {2}) : nullptr;
+                    auto* w = raw ? builder.AddCompositeExtract(floatTypeId, raw->result_id(), {3}) : nullptr;
+                    auto* pushVectorPtr = builder.AddAccessChain(
+                        pushVectorPtrTypeId, pushVariableId, {memberZeroId});
+                    auto* pushVector = pushVectorPtr ? builder.AddLoad(vectorTypeId, pushVectorPtr->result_id()) : nullptr;
+                    auto* framebufferHeight = pushVector
+                        ? builder.AddCompositeExtract(floatTypeId, pushVector->result_id(), {1}) : nullptr;
+                    auto* correctedY = (framebufferHeight && y)
+                        ? builder.AddBinaryOp(floatTypeId, spv::Op::OpFSub,
+                                              framebufferHeight->result_id(), y->result_id()) : nullptr;
+                    if (!x || !z || !w || !correctedY) return Status::Failure;
+                    auto* corrected = builder.AddCompositeConstruct(
+                        vectorTypeId, {x->result_id(), correctedY->result_id(), z->result_id(), w->result_id()});
+                    if (!corrected || !builder.AddStore(correctedVariable->result_id(), corrected->result_id())) {
+                        return Status::Failure;
+                    }
+                    modified = true;
+                }
+
+                if (!modified) return Status::SuccessWithoutChange;
+                context()->InvalidateAnalysesExceptFor(IRContext::kAnalysisNone);
+                return Status::SuccessWithChange;
+            }
+        };
+
+        Bool TransformSpirvForOpenGLFragCoord(const Vector<Uint>& input, Vector<Uint>& output) {
+            spvtools::Optimizer optimizer(SPV_ENV_VULKAN_1_3);
+            spvtools::OptimizerOptions options;
+            options.set_run_validator(false);
+            optimizer.RegisterPass(spvtools::Optimizer::PassToken(MakeUnique<GlFragCoordLowerLeftPass>()));
+            const Bool success = optimizer.Run(input.data(), input.size(), &output, options);
+            if (!success) {
+                MGLOG_E("Vulkan: failed to run OpenGL FragCoord transform pass");
+                output = input;
+            }
+            return success;
+        }

index 00000000..bd66387d
--- /dev/null
+++ b/tools/native_harness/textured_quad_fixture.cpp
@@ -0,0 +1,333 @@
+// A deliberately small desktop-GL workload for reducing texture/vertex/shader
+// mismatches found in large application traces. Capture it under stock Mesa,
+// then replay the same trace through each MobileGL backend.
+
+#include <GL/glew.h>
+#include <GLFW/glfw3.h>
+
+#include <array>
+#include <cstdint>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <fstream>
+#include <string_view>
+#include <string>
+#include <vector>
+
+namespace {
+
+struct Options {
+    bool constantFragment = false;
+    bool constantUv = false;
+    bool generateMipmap = true;
+    bool samplerObject = true;
+    bool bgraUpload = true;
+    bool largeTexture = false;
+    bool churnTextures = false;
+    const char* textureFile = nullptr;
+    bool stkState = false;
+    bool depthState = false;
+    bool cullState = false;
+    bool stkShaderHeader = false;
+};
+
+bool HasArgument(int argc, char** argv, std::string_view argument) {
+    for (int i = 1; i < argc; ++i) {
+        if (argv[i] == argument) return true;
+    }
+    return false;
+}
+
+const char* ArgumentValue(int argc, char** argv, std::string_view argument) {
+    for (int i = 1; i + 1 < argc; ++i) {
+        if (argv[i] == argument) return argv[i + 1];
+    }
+    return nullptr;
+}
+
+void Fail(const char* message) {
+    std::fprintf(stderr, "textured_quad_fixture: %s\n", message);
+    std::exit(1);
+}
+
+GLuint Compile(GLenum stage, const char* source) {
+    const GLuint shader = glCreateShader(stage);
+    glShaderSource(shader, 1, &source, nullptr);
+    glCompileShader(shader);
+    GLint compiled = GL_FALSE;
+    glGetShaderiv(shader, GL_COMPILE_STATUS, &compiled);
+    if (compiled == GL_FALSE) {
+        std::array<char, 4096> log{};
+        glGetShaderInfoLog(shader, static_cast<GLsizei>(log.size()), nullptr, log.data());
+        std::fprintf(stderr, "%s\n", log.data());
+        Fail("shader compilation failed");
+    }
+    return shader;
+}
+
+GLuint Link(GLuint vertexShader, GLuint fragmentShader) {
+    const GLuint program = glCreateProgram();
+    glAttachShader(program, vertexShader);
+    glAttachShader(program, fragmentShader);
+    glBindAttribLocation(program, 0, "Position");
+    glBindAttribLocation(program, 3, "Texcoord");
+    glLinkProgram(program);
+    GLint linked = GL_FALSE;
+    glGetProgramiv(program, GL_LINK_STATUS, &linked);
+    if (linked == GL_FALSE) {
+        std::array<char, 4096> log{};
+        glGetProgramInfoLog(program, static_cast<GLsizei>(log.size()), nullptr, log.data());
+        std::fprintf(stderr, "%s\n", log.data());
+        Fail("program link failed");
+    }
+    return program;
+}
+
+std::vector<std::uint8_t> MakeTexture(bool bgra, int width, int height) {
+    std::vector<std::uint8_t> pixels(width * height * 4);
+    for (int y = 0; y < height; ++y) {
+        for (int x = 0; x < width; ++x) {
+            const bool checker = ((x / 16) ^ (y / 16)) & 1;
+            const std::uint8_t r = checker ? 238 : static_cast<std::uint8_t>(24 + x / 4);
+            const std::uint8_t g = checker ? static_cast<std::uint8_t>(80 + y) : 32;
+            const std::uint8_t b = checker ? 28 : static_cast<std::uint8_t>(220 - y);
+            const std::size_t offset = static_cast<std::size_t>(y * width + x) * 4;
+            pixels[offset + 0] = bgra ? b : r;
+            pixels[offset + 1] = g;
+            pixels[offset + 2] = bgra ? r : b;
+            pixels[offset + 3] = 255;
+        }
+    }
+    return pixels;
+}
+
+} // namespace
+
+int main(int argc, char** argv) {
+    const Options options{
+        .constantFragment = HasArgument(argc, argv, "--constant-fragment"),
+        .constantUv = HasArgument(argc, argv, "--constant-uv"),
+        .generateMipmap = !HasArgument(argc, argv, "--no-mipmap"),
+        .samplerObject = !HasArgument(argc, argv, "--no-sampler"),
+        .bgraUpload = !HasArgument(argc, argv, "--rgba-upload"),
+        .largeTexture = HasArgument(argc, argv, "--large-texture"),
+        .churnTextures = HasArgument(argc, argv, "--churn-textures"),
+        .textureFile = ArgumentValue(argc, argv, "--texture-file"),
+        .stkState = HasArgument(argc, argv, "--stk-state"),
+        .depthState = HasArgument(argc, argv, "--depth-state") || HasArgument(argc, argv, "--stk-state"),
+        .cullState = HasArgument(argc, argv, "--cull-state") || HasArgument(argc, argv, "--stk-state"),
+        .stkShaderHeader = HasArgument(argc, argv, "--stk-shader-header"),
+    };
+
+    if (glfwInit() == GLFW_FALSE) Fail("glfwInit failed");
+    glfwWindowHint(GLFW_CONTEXT_VERSION_MAJOR, 4);
+    glfwWindowHint(GLFW_CONTEXT_VERSION_MINOR, 4);
+    glfwWindowHint(GLFW_OPENGL_PROFILE, GLFW_OPENGL_CORE_PROFILE);
+    glfwWindowHint(GLFW_RESIZABLE, GLFW_FALSE);
+    GLFWwindow* window = glfwCreateWindow(960, 540, "MobileGL textured quad fixture", nullptr, nullptr);
+    if (window == nullptr) Fail("window creation failed");
+    glfwMakeContextCurrent(window);
+    glewExperimental = GL_TRUE;
+    if (glewInit() != GLEW_OK) Fail("GLEW initialization failed");
+    while (glGetError() != GL_NO_ERROR) {}
+
+    const char* basicVertexSource = options.constantUv ? R"GLSL(
+#version 440 core
+layout(location=0) in vec2 Position;
+layout(location=3) in vec2 Texcoord;
+uniform vec2 center;
+uniform vec2 size;
+uniform vec2 texcenter;
+uniform vec2 texsize;
+out vec2 uv;
+void main() {
+    uv = vec2(0.5, 0.5);
+    gl_Position = vec4(Position * size + center, 0.0, 1.0);
+}
+)GLSL" : R"GLSL(
+#version 440 core
+layout(location=0) in vec2 Position;
+layout(location=3) in vec2 Texcoord;
+uniform vec2 center;
+uniform vec2 size;
+uniform vec2 texcenter;
+uniform vec2 texsize;
+out vec2 uv;
+void main() {
+    uv = Texcoord * texsize + texcenter;
+    gl_Position = vec4(Position * size + center, 0.0, 1.0);
+}
+)GLSL";
+    const char* basicFragmentSource = options.constantFragment ? R"GLSL(
+#version 440 core
+in vec2 uv;
+layout(location=0) out vec4 FragColor;
+void main() { FragColor = vec4(0.25, 0.5, 0.75, 1.0); }
+)GLSL" : R"GLSL(
+#version 440 core
+uniform sampler2D tex;
+in vec2 uv;
+layout(location=0) out vec4 FragColor;
+void main() { FragColor = texture(tex, uv); }
+)GLSL";
+
+    const char* stkHeader = R"GLSL(
+#version 460 core
+layout(std140) uniform Matrices {
+    mat4 u_view_matrix;
+    mat4 u_projection_matrix;
+    mat4 u_inverse_view_matrix;
+    mat4 u_inverse_projection_matrix;
+    mat4 u_projection_view_matrix;
+    mat4 u_shadow_projection_view_matrices[4];
+    vec2 u_screen;
+};
+layout(std140) uniform LightingData {
+    vec3 sun_direction;
+    vec3 sun_col;
+    float sun_angle;
+    float lighting_coefficients[27];
+};
+layout(std140) uniform SPFogData {
+    vec4 u_fog_data;
+    vec4 u_fog_color;
+};
+)GLSL";
+    std::string stkVertexSource;
+    std::string stkFragmentSource;
+    if (options.stkShaderHeader) {
+        stkVertexSource = std::string(stkHeader) + R"GLSL(
+uniform vec2 center;
+uniform vec2 size;
+uniform vec2 texcenter;
+uniform vec2 texsize;
+layout(location=0) in vec2 Position;
+layout(location=3) in vec2 Texcoord;
+out vec2 uv;
+void main() {
+    uv = Texcoord * texsize + texcenter;
+    gl_Position = vec4(Position * size + center, 0.0, 1.0);
+}
+)GLSL";
+        stkFragmentSource = std::string(stkHeader) + R"GLSL(
+uniform sampler2D tex;
+in vec2 uv;
+layout(location=0) out vec4 FragColor;
+void main() { FragColor = texture(tex, uv); }
+)GLSL";
+    }
+    const char* vertexSource = options.stkShaderHeader ? stkVertexSource.c_str() : basicVertexSource;
+    const char* fragmentSource = options.stkShaderHeader ? stkFragmentSource.c_str() : basicFragmentSource;
+
+    const GLuint vertexShader = Compile(GL_VERTEX_SHADER, vertexSource);
+    const GLuint fragmentShader = Compile(GL_FRAGMENT_SHADER, fragmentSource);
+    const GLuint program = Link(vertexShader, fragmentShader);
+
+    constexpr std::array<float, 16> vertices = {
+        -1.0f, -1.0f, -1.0f,  1.0f,
+        -1.0f,  1.0f, -1.0f, -1.0f,
+         1.0f, -1.0f,  1.0f,  1.0f,
+         1.0f,  1.0f,  1.0f, -1.0f,
+    };
+    GLuint buffer = 0;
+    GLuint vao = 0;
+    glGenBuffers(1, &buffer);
+    glBindBuffer(GL_ARRAY_BUFFER, buffer);
+    glBufferData(GL_ARRAY_BUFFER, sizeof(vertices), vertices.data(), GL_STATIC_DRAW);
+    glGenVertexArrays(1, &vao);
+    glBindVertexArray(vao);
+    glEnableVertexAttribArray(0);
+    glEnableVertexAttribArray(3);
+    glVertexAttribPointer(0, 2, GL_FLOAT, GL_FALSE, 4 * sizeof(float), nullptr);
+    glVertexAttribPointer(3, 2, GL_FLOAT, GL_FALSE, 4 * sizeof(float),
+                          reinterpret_cast<void*>(2 * sizeof(float)));
+
+    GLuint texture = 0;
+    glGenTextures(1, &texture);
+    glBindTexture(GL_TEXTURE_2D, texture);
+    const int textureWidth = options.largeTexture ? 2048 : 256;
+    const int textureHeight = options.largeTexture ? 1024 : 128;
+    auto pixels = MakeTexture(options.bgraUpload, textureWidth, textureHeight);
+    if (options.textureFile != nullptr) {
+        std::ifstream input(options.textureFile, std::ios::binary | std::ios::ate);
+        if (!input) Fail("could not open texture file");
+        const auto length = input.tellg();
+        if (length != static_cast<std::streamoff>(pixels.size())) Fail("texture file has the wrong size");
+        input.seekg(0);
+        input.read(reinterpret_cast<char*>(pixels.data()), static_cast<std::streamsize>(pixels.size()));
+        if (!input) Fail("could not read texture file");
+    }
+    glTexImage2D(GL_TEXTURE_2D, 0, GL_RGBA8, textureWidth, textureHeight, 0,
+                 options.bgraUpload ? GL_BGRA : GL_RGBA, GL_UNSIGNED_BYTE, pixels.data());
+    if (options.generateMipmap) glGenerateMipmap(GL_TEXTURE_2D);
+
+    std::vector<GLuint> churnedTextures;
+    if (options.churnTextures) {
+        churnedTextures.resize(66);
+        glGenTextures(static_cast<GLsizei>(churnedTextures.size()), churnedTextures.data());
+        for (std::size_t i = 0; i < churnedTextures.size(); ++i) {
+            const int width = 64 << (i % 3);
+            const int height = 32 + static_cast<int>(i % 5) * 16;
+            auto churnPixels = MakeTexture(true, width, height);
+            glBindTexture(GL_TEXTURE_2D, churnedTextures[i]);
+            glTexImage2D(GL_TEXTURE_2D, 0, GL_RGBA8, width, height, 0,
+                         GL_BGRA, GL_UNSIGNED_BYTE, churnPixels.data());
+            glGenerateMipmap(GL_TEXTURE_2D);
+        }
+        glBindTexture(GL_TEXTURE_2D, texture);
+    }
+
+    GLuint sampler = 0;
+    if (options.samplerObject) {
+        glGenSamplers(1, &sampler);
+        glSamplerParameteri(sampler, GL_TEXTURE_MAG_FILTER, GL_LINEAR);
+        glSamplerParameteri(sampler, GL_TEXTURE_MIN_FILTER, GL_LINEAR);
+        glSamplerParameteri(sampler, GL_TEXTURE_WRAP_S, GL_CLAMP_TO_EDGE);
+        glSamplerParameteri(sampler, GL_TEXTURE_WRAP_T, GL_CLAMP_TO_EDGE);
+        glBindSampler(0, sampler);
+    } else {
+        glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, GL_LINEAR);
+        glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, GL_LINEAR);
+        glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_S, GL_CLAMP_TO_EDGE);
+        glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_T, GL_CLAMP_TO_EDGE);
+    }
+
+    glViewport(0, 0, 960, 540);
+    if (options.cullState) {
+        glEnable(GL_CULL_FACE);
+        glCullFace(GL_BACK);
+        glFrontFace(GL_CW);
+    }
+    if (options.depthState) {
+        glEnable(GL_DEPTH_TEST);
+        glDepthFunc(GL_LEQUAL);
+        glDepthMask(GL_TRUE);
+    }
+    if (options.stkState) {
+        glDisable(GL_MULTISAMPLE);
+        glPolygonOffset(-1.0f, 0.0f);
+    }
+    glClearColor(0.1f, 0.12f, 0.16f, 1.0f);
+    glClear(options.depthState ? GL_COLOR_BUFFER_BIT | GL_DEPTH_BUFFER_BIT : GL_COLOR_BUFFER_BIT);
+    glUseProgram(program);
+    glUniform2f(glGetUniformLocation(program, "center"), 0.0f, 0.0f);
+    glUniform2f(glGetUniformLocation(program, "size"), 1.0f, 1.0f);
+    glUniform2f(glGetUniformLocation(program, "texcenter"), 0.5f, 0.5f);
+    glUniform2f(glGetUniformLocation(program, "texsize"), 0.5f, 0.5f);
+    const GLint texLocation = glGetUniformLocation(program, "tex");
+    if (texLocation >= 0) glUniform1i(texLocation, 0);
+    glDrawArrays(GL_TRIANGLE_STRIP, 0, 4);
+    glFinish();
+    glfwSwapBuffers(window);
+
+    const GLenum error = glGetError();

+TEST_F(ProgramUtilTest, LegalizeIntegerTexelFetchToPlainTexture) {
+    using namespace MG_Util::ShaderTranspiler;
+
+    const String spirvText = R"(
+               OpCapability Shader
+               OpCapability ImageQuery
+               OpMemoryModel Logical GLSL450
+               OpEntryPoint Fragment %main "main" %color
+               OpExecutionMode %main OriginUpperLeft
+               OpName %source "source"
+               OpDecorate %color Location 0
+               OpDecorate %source Binding 0
+               OpDecorate %source DescriptorSet 0
+       %void = OpTypeVoid
+     %mainFn = OpTypeFunction %void
+       %uint = OpTypeInt 32 0
+     %v4uint = OpTypeVector %uint 4
+        %int = OpTypeInt 32 1
+      %v2int = OpTypeVector %int 2
+ %outV4Ptr = OpTypePointer Output %v4uint
+      %image = OpTypeImage %uint 2D 0 0 0 1 Unknown
+    %sampled = OpTypeSampledImage %image
+  %samplePtr = OpTypePointer UniformConstant %sampled
+      %color = OpVariable %outV4Ptr Output
+     %source = OpVariable %samplePtr UniformConstant
+       %zero = OpConstant %int 0
+        %one = OpConstant %int 1
+      %coord = OpConstantComposite %v2int %zero %zero
+     %offset = OpConstantComposite %v2int %one %zero
+       %main = OpFunction %void None %mainFn
+      %entry = OpLabel
+     %loaded = OpLoad %sampled %source
+  %plainImage = OpImage %image %loaded
+       %size = OpImageQuerySizeLod %v2int %plainImage %zero
+      %texel = OpImageFetch %v4uint %plainImage %coord Lod|ConstOffset %zero %offset
+               OpStore %color %texel
+               OpReturn
+               OpFunctionEnd
+)";
+
+    spvtools::SpirvTools tools(SPV_ENV_VULKAN_1_1);
+    Vector<uint32_t> inputBinary;
+    ASSERT_TRUE(tools.Assemble(spirvText, &inputBinary));
+
+    spvtools::Optimizer optimizer(SPV_ENV_VULKAN_1_1);
+    optimizer.RegisterPass(LegalizeIntegerTexelFetchPass::CreateLegalizeIntegerTexelFetchPass());
+    optimizer.RegisterPass(spvtools::CreateAggressiveDCEPass(false));
+    Vector<uint32_t> outputBinary;
+    ASSERT_TRUE(optimizer.Run(inputBinary.data(), inputBinary.size(), &outputBinary));
+    String outputText;
+    ASSERT_TRUE(tools.Disassemble(outputBinary, &outputText));
+    ASSERT_TRUE(tools.Validate(outputBinary)) << outputText;
+    EXPECT_EQ(outputText.find("OpTypeSampledImage"), String::npos);
+    EXPECT_EQ(outputText.find("OpImage "), String::npos);
+    EXPECT_NE(outputText.find("OpImageFetch"), String::npos);
+    EXPECT_NE(outputText.find("OpIAdd"), String::npos);
+    EXPECT_EQ(outputText.find("ConstOffset"), String::npos);
+    EXPECT_NE(outputText.find("OpTypeImage %uint"), String::npos);
+}

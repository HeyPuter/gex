+    Bool WebGPURenderer::BlitDepthAttachment(GLint srcX0, GLint srcY0, GLint srcX1, GLint srcY1,
+                                              GLint dstX0, GLint dstY0, GLint dstX1, GLint dstY1) {
+        WgpuDepthAttachment source, destination;
+        if (!ResolveDepthAttachment(FramebufferTarget::Read, source) ||
+            !ResolveDepthAttachment(FramebufferTarget::Draw, destination) || destination.samples != 1)
+            return false;
+        const GLint srcMinX = std::min(srcX0, srcX1), srcMinY = std::min(srcY0, srcY1);
+        const GLint srcMaxX = std::max(srcX0, srcX1), srcMaxY = std::max(srcY0, srcY1);
+        const GLint dstMinX = std::min(dstX0, dstX1), dstMinY = std::min(dstY0, dstY1);
+        const GLint dstMaxX = std::max(dstX0, dstX1), dstMaxY = std::max(dstY0, dstY1);
+        if (srcMinX < 0 || srcMinY < 0 || dstMinX < 0 || dstMinY < 0 ||
+            srcMaxX > static_cast<GLint>(source.width) || srcMaxY > static_cast<GLint>(source.height) ||
+            dstMaxX > static_cast<GLint>(destination.width) || dstMaxY > static_cast<GLint>(destination.height) ||
+            srcX0 == srcX1 || srcY0 == srcY1 || dstX0 == dstX1 || dstY0 == dstY1) return false;
+        WGPURenderPipeline pipeline = GetOrCreateDepthResolvePipeline(source.samples > 1, destination.format);
+        if (!pipeline) return false;
+        BeginFrameIfNeeded();
+        if (!m_frameActive || !m_encoder) return false;
+        WGPUBindGroupLayout layout = wgpuRenderPipelineGetBindGroupLayout(pipeline, 0);
+        const float scaleX = static_cast<float>(srcX1 - srcX0) / static_cast<float>(dstX1 - dstX0);
+        const float scaleY = static_cast<float>(srcY1 - srcY0) / static_cast<float>(dstY1 - dstY0);
+        const float values[4] = {static_cast<float>(srcX0) - static_cast<float>(dstX0) * scaleX,
+                                 static_cast<float>(srcY0) - static_cast<float>(dstY0) * scaleY,
+                                 scaleX, scaleY};
+        WGPUBufferDescriptor bufferDesc{};
+        bufferDesc.size = sizeof(values);
+        bufferDesc.usage = WGPUBufferUsage_Uniform | WGPUBufferUsage_CopyDst;
+        WGPUBuffer uniform = wgpuDeviceCreateBuffer(m_device, &bufferDesc);
+        wgpuQueueWriteBuffer(m_queue, uniform, 0, values, sizeof(values));
+        WGPUBindGroupEntry entries[2]{};
+        entries[0].binding = 0;
+        entries[0].textureView = source.sampledView;
+        entries[1].binding = 1;
+        entries[1].buffer = uniform;
+        entries[1].size = sizeof(values);
+        WGPUBindGroupDescriptor bindDesc{};
+        bindDesc.layout = layout;
+        bindDesc.entryCount = 2;
+        bindDesc.entries = entries;
+        WGPUBindGroup group = wgpuDeviceCreateBindGroup(m_device, &bindDesc);
+        WGPURenderPassDepthStencilAttachment depth{};
+        depth.view = destination.attachmentView;
+        depth.depthLoadOp = WGPULoadOp_Load;
+        depth.depthStoreOp = WGPUStoreOp_Store;
+        if (HasStencilAspect(destination.format)) {
+            depth.stencilLoadOp = WGPULoadOp_Load;
+            depth.stencilStoreOp = WGPUStoreOp_Store;
+        }
+        WGPURenderPassDescriptor passDesc{};
+        passDesc.depthStencilAttachment = &depth;
+        WGPURenderPassEncoder pass = wgpuCommandEncoderBeginRenderPass(m_encoder, &passDesc);
+        wgpuRenderPassEncoderSetPipeline(pass, pipeline);
+        wgpuRenderPassEncoderSetBindGroup(pass, 0, group, 0, nullptr);
+        wgpuRenderPassEncoderSetViewport(pass, static_cast<float>(dstMinX), static_cast<float>(dstMinY),
+                                         static_cast<float>(dstMaxX - dstMinX),
+                                         static_cast<float>(dstMaxY - dstMinY), 0.0f, 1.0f);
+        wgpuRenderPassEncoderDraw(pass, 3, 1, 0, 0);
+        wgpuRenderPassEncoderEnd(pass);
+        wgpuRenderPassEncoderRelease(pass);
+        wgpuBindGroupRelease(group);
+        wgpuBindGroupLayoutRelease(layout);
+        wgpuBufferRelease(uniform);
+        return true;
+    }
+
+    Bool WebGPURenderer::ExtractStencilMask(const WgpuDepthAttachment& source,
+                                             WGPUTexture& outTexture, WGPUTextureView& outView) {
+        outTexture = nullptr;
+        outView = nullptr;
+        if (!HasStencilAspect(source.format) || !source.attachmentView) return false;
+        BeginFrameIfNeeded();
+        if (!m_frameActive || !m_encoder) return false;
+        WGPUTextureDescriptor targetDesc{};
+        targetDesc.usage = WGPUTextureUsage_RenderAttachment;
+        if (source.samples == 1) {
+            // In the single-sample case this texture is also the returned
+            // extraction mask, so it must be bindable and readable.
+            targetDesc.usage |= WGPUTextureUsage_TextureBinding | WGPUTextureUsage_CopySrc;
+        }
+        targetDesc.dimension = WGPUTextureDimension_2D;
+        targetDesc.size = {source.width, source.height, 1};
+        targetDesc.format = WGPUTextureFormat_R8Unorm;
+        targetDesc.mipLevelCount = 1;
+        targetDesc.sampleCount = source.samples;
+        WGPUTexture multisampleTexture = wgpuDeviceCreateTexture(m_device, &targetDesc);
+        WGPUTextureView multisampleView = multisampleTexture ? wgpuTextureCreateView(multisampleTexture, nullptr) : nullptr;
+        if (!multisampleTexture || !multisampleView) return false;
+        if (source.samples > 1) {
+            targetDesc.usage = WGPUTextureUsage_RenderAttachment | WGPUTextureUsage_TextureBinding |
+                               WGPUTextureUsage_CopySrc;
+            targetDesc.sampleCount = 1;
+            outTexture = wgpuDeviceCreateTexture(m_device, &targetDesc);
+            outView = outTexture ? wgpuTextureCreateView(outTexture, nullptr) : nullptr;
+        } else {
+            outTexture = multisampleTexture;
+            outView = multisampleView;
+        }
+        if (!outTexture || !outView) return false;
+        WGPURenderPassColorAttachment color{};
+        color.view = multisampleView;
+        color.resolveTarget = source.samples > 1 ? outView : nullptr;
+        color.depthSlice = WGPU_DEPTH_SLICE_UNDEFINED;
+        color.loadOp = WGPULoadOp_Clear;
+        color.storeOp = WGPUStoreOp_Store;
+        WGPURenderPassDepthStencilAttachment depth{};
+        depth.view = source.attachmentView;
+        depth.depthLoadOp = WGPULoadOp_Load;
+        depth.depthStoreOp = WGPUStoreOp_Store;
+        depth.stencilLoadOp = WGPULoadOp_Load;
+        depth.stencilStoreOp = WGPUStoreOp_Store;
+        WGPURenderPassDescriptor passDesc{};
+        passDesc.colorAttachmentCount = 1;
+        passDesc.colorAttachments = &color;
+        passDesc.depthStencilAttachment = &depth;
+        WGPURenderPassEncoder pass = wgpuCommandEncoderBeginRenderPass(m_encoder, &passDesc);
+        for (Uint32 bit = 1; bit <= 128; bit <<= 1) {
+            WGPURenderPipeline pipeline = GetOrCreateStencilExtractPipeline(source.format, source.samples, bit);
+            if (!pipeline) continue;
+            wgpuRenderPassEncoderSetPipeline(pass, pipeline);
+            wgpuRenderPassEncoderSetStencilReference(pass, bit);
+            wgpuRenderPassEncoderDraw(pass, 3, 1, 0, 0);
+        }
+        wgpuRenderPassEncoderEnd(pass);
+        wgpuRenderPassEncoderRelease(pass);
+        if (source.samples > 1) {
+            wgpuTextureViewRelease(multisampleView);
+            wgpuTextureRelease(multisampleTexture);
+        }
+        return true;
+    }

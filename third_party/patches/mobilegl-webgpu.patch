@@ -0,0 +1,98 @@
+#!/usr/bin/env python3
+"""Replay one apitrace checkpoint on stock Mesa for differential testing.
+
+This adapter deliberately keeps Mesa outside MobileGL.  Comparing DirectVulkan
+and DirectWebGPU alone cannot reveal bugs shared by MobileGL's GL frontend.
+"""
+
+from __future__ import annotations
+
+import argparse
+import os
+import shutil
+import subprocess
+from pathlib import Path
+
+
+def command_prefix(force_xvfb: bool) -> list[str]:
+    if force_xvfb or not os.environ.get("DISPLAY"):
+        xvfb = shutil.which("xvfb-run")
+        if not xvfb:
+            raise RuntimeError("DISPLAY is unset and xvfb-run was not found")
+        return [
+            xvfb,
+            "-a",
+            "-s",
+            "-screen 0 960x540x24 +extension GLX +render -noreset",
+        ]
+    return []
+
+
+def run_logged(argv: list[str], log: Path, stdout: Path | None = None) -> None:
+    env = os.environ.copy()
+    env.setdefault("LIBGL_ALWAYS_SOFTWARE", "1")
+    with log.open("w") as error_file:
+        if stdout is None:
+            completed = subprocess.run(
+                argv, env=env, text=True, stdout=error_file, stderr=subprocess.STDOUT,
+                check=False,
+            )
+        else:
+            with stdout.open("w") as output_file:
+                completed = subprocess.run(
+                    argv, env=env, text=True, stdout=output_file, stderr=error_file,
+                    check=False,
+                )
+    if completed.returncode:
+        raise RuntimeError(f"Mesa glretrace exited {completed.returncode}; see {log}")
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--glretrace", required=True, type=Path)
+    parser.add_argument("--trace", required=True, type=Path)
+    parser.add_argument("--target-call", required=True, type=int)
+    parser.add_argument("--output", required=True, type=Path)
+    parser.add_argument("--dump-state", action="store_true")
+    parser.add_argument("--xvfb", action="store_true")
+    args = parser.parse_args()
+
+    args.output.mkdir(parents=True, exist_ok=True)
+    prefix = args.output / "mesa."
+    base = command_prefix(args.xvfb) + [
+        str(args.glretrace),
+        "--singlethread",
+        "--no-context-check",
+        "--debug",
+    ]
+    run_logged(
+        base + [
+            "--snapshot-alpha",
+            f"--snapshot-prefix={prefix}",
+            f"--snapshot={args.target_call}",
+            str(args.trace),
+        ],
+        args.output / "retrace.log",
+    )
+
+    snapshots = sorted(args.output.glob("mesa.*.png"))
+    if len(snapshots) != 1:
+        raise RuntimeError(
+            f"expected one Mesa snapshot for call {args.target_call}, got {len(snapshots)}"
+        )
+    shutil.copyfile(snapshots[0], args.output / "actual.png")
+
+    # State dumping and call snapshots both stop replay at their requested call,
+    # so collect state in a second deterministic replay when requested.
+    if args.dump_state:
+        run_logged(
+            base + [f"--dump-state={args.target_call}", str(args.trace)],
+            args.output / "state-retrace.log",
+            args.output / "state.json",
+        )
+
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())

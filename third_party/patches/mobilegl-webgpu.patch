+        const float values[4] = {static_cast<float>(srcX0) - static_cast<float>(dstX0) * scaleX,
+                                 static_cast<float>(srcY0) - static_cast<float>(dstY0) * scaleY,
+                                 scaleX, scaleY};
+        WGPUBufferDescriptor bufferDesc{};

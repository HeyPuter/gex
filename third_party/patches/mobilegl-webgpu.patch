+                error, options.bgraUpload, options.generateMipmap, options.samplerObject,
+                options.constantUv, options.constantFragment, textureWidth, textureHeight, options.churnTextures,
+                options.stkState);
+
+    glfwDestroyWindow(window);
+    glfwTerminate();
+    return error == GL_NO_ERROR ? 0 : 2;
+}

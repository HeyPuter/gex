+#pragma once
+
+#include "source/opt/pass.h"
+#include "spirv-tools/optimizer.hpp"
+
+namespace MobileGL::MG_Util::ShaderTranspiler {
+    // WGSL has integer sampled textures, but no filtered integer sampler operation.
+    // Tint consequently rejects SPIR-V's OpTypeSampledImage when its component type is
+    // signed or unsigned integer, even when the shader only uses texelFetch().  For that
+    // safe subset, erase the unused sampler half and feed OpImageFetch a plain image.
+    //
+    // This pass deliberately leaves filtered sampling and sampler-valued control/data
+    // flow untouched.  Those require semantic coordinate/LOD lowering, not a type trick.
+    class LegalizeIntegerTexelFetchPass final : public spvtools::opt::Pass {
+    public:
+        const char* name() const override { return "legalize-integer-texel-fetch"; }
+        Status Process() override;
+
+        static spvtools::Optimizer::PassToken CreateLegalizeIntegerTexelFetchPass();
+    };
+} // namespace MobileGL::MG_Util::ShaderTranspiler

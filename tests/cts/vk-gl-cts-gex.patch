diff --git a/targets/gex/gex.cmake b/targets/gex/gex.cmake
new file mode 100644
index 0000000..288e9b4
--- /dev/null
+++ b/targets/gex/gex.cmake
@@ -0,0 +1,15 @@
+message("*** Using gex EGL/OpenGL target")
+
+# The guest implementation is loaded at runtime under its ordinary sonames;
+# no host-architecture GL/EGL library may leak into this cross build.
+set(DEQP_TARGET_NAME "gex")
+set(DEQP_USE_SURFACELESS ON)
+if(NOT GEX_GUEST_GL_LIBRARY)
+    message(FATAL_ERROR "GEX_GUEST_GL_LIBRARY must name the aarch64 guest GL marshaller")
+endif()
+# The generic surfaceless platform resolves most EGL/GL calls dynamically, but
+# config enumeration and pbuffer creation are direct references. Link those to
+# the exact same one-object EGL/GLES marshaller that the browser guest loads.
+set(DEQP_PLATFORM_LIBRARIES "${GEX_GUEST_GL_LIBRARY}" dl pthread)
+add_definitions(-DDEQP_OPENGL_LIBRARY_PATH="libGLESv2.so.2")
+include_directories("${CMAKE_SOURCE_DIR}/../mobilegl-webgpu/include")

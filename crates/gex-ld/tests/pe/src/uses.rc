// uses.exe's resources: a numbered string table, a named custom resource and
// a version block, so the resource index has IDs, names and several types.
#include <winver.h>
STRINGTABLE
BEGIN
    1 "first string"
    2 "second string"
END
GREETING RCDATA { "hello\0" }
1 VERSIONINFO
FILEVERSION 1,2,3,4
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "gex PE fixture\0"
        END
    END
END

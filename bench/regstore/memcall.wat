;; What gex emits today: a ring of blocks, each flushing its live registers to
;; the context on the way out and loading them back on the way in, with a
;; `return_call` between. Eight registers, which is about twice what a block
;; actually flushes, so this brackets the real cost from above.
(module
  (import "gex" "memory" (memory 16))
  (func $blk (param $ctx i32)
    (local $r0 i64) (local $r1 i64) (local $r2 i64) (local $r3 i64)
    (local $r4 i64) (local $r5 i64) (local $r6 i64) (local $r7 i64)
    (local.set $r0 (i64.load (i32.const 344)))
    (local.set $r1 (i64.load (i32.const 352)))
    (local.set $r2 (i64.load (i32.const 360)))
    (local.set $r3 (i64.load (i32.const 368)))
    (local.set $r4 (i64.load (i32.const 376)))
    (local.set $r5 (i64.load (i32.const 384)))
    (local.set $r6 (i64.load (i32.const 392)))
    (local.set $r7 (i64.load (i32.const 400)))
    (if (i64.eqz (local.get $r0)) (then (return)))
    (local.set $r0 (i64.sub (local.get $r0) (i64.const 1)))
    (local.set $r1 (i64.add (local.get $r1) (local.get $r2)))
    (local.set $r3 (i64.xor (local.get $r3) (local.get $r1)))
    (i64.store (i32.const 344) (local.get $r0))
    (i64.store (i32.const 352) (local.get $r1))
    (i64.store (i32.const 360) (local.get $r2))
    (i64.store (i32.const 368) (local.get $r3))
    (i64.store (i32.const 376) (local.get $r4))
    (i64.store (i32.const 384) (local.get $r5))
    (i64.store (i32.const 392) (local.get $r6))
    (i64.store (i32.const 400) (local.get $r7))
    (return_call $blk (local.get $ctx)))
  (func (export "run") (param $n i32) (result i64)
    (i64.store (i32.const 344) (i64.extend_i32_u (local.get $n)))
    (i64.store (i32.const 352) (i64.const 1))
    (i64.store (i32.const 360) (i64.const 3))
    (i64.store (i32.const 368) (i64.const 7))
    (call $blk (i32.const 0))
    (i64.load (i32.const 368)))
)

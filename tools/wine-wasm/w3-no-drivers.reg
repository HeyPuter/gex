REGEDIT4

; The kernel drivers a W3 session cannot load (docs/wine-native.md §3.17):
; MountMgr, winebus, wineusb and winebth each need a Unix library the W3
; loader does not have (DriverEntry fails with STATUS_DLL_NOT_FOUND), so
; services.exe would start a winedevice for each only to see it fail.
; MountMgr becomes demand-start and the three root bus devices go, so
; services starts none of them. For every W3 prefix, games included: the
; drivers do nothing under W3 today. Remove this when they get their Unix
; sides.
;   wine regedit /S w3-no-drivers.reg   (or edit the prefix's system.reg)

[HKEY_LOCAL_MACHINE\System\CurrentControlSet\Services\MountMgr]
"Start"=dword:00000003

[-HKEY_LOCAL_MACHINE\System\CurrentControlSet\Enum\ROOT\WINE\WINEBUS]
[-HKEY_LOCAL_MACHINE\System\CurrentControlSet\Enum\ROOT\WINE\WINEUSB]
[-HKEY_LOCAL_MACHINE\System\CurrentControlSet\Enum\ROOT\WINE\WINEBTH]

+++ b/src/mono/mono/utils/mono-threads-gex.c
@@ -0,0 +1,60 @@
+/**
+ * \file
+ * gex (noita-wasm docs/unity-dotnet.md): Mono as wasm64 inside an x86-64
+ * Linux guest. Threads are POSIX threads (mono-threads-posix.c, musl's
+ * pthreads over gex-kernel's clone and futex); suspension is cooperative
+ * only, as on every wasm host: no signal can interrupt wasm code.
+ */
+
+#include "config.h"
+
+#include <mono/utils/mono-threads.h>
+#include <mono/utils/mono-threads-coop.h>
+
+#if defined (USE_GEX_BACKEND)
+
+void
+mono_threads_suspend_init_signals (void)
+{
+}
+
+void
+mono_threads_suspend_init (void)
+{
+	g_assert (mono_threads_is_cooperative_suspension_enabled ());
+}
+
+void
+mono_threads_suspend_register (MonoThreadInfo *info)
+{
+}
+
+void
+mono_threads_suspend_free (MonoThreadInfo *info)
+{
+}
+
+gboolean
+mono_threads_suspend_begin_async_suspend (MonoThreadInfo *info, gboolean interrupt_kernel)
+{
+	return TRUE;
+}
+
+gboolean
+mono_threads_suspend_check_suspend_result (MonoThreadInfo *info)
+{
+	return TRUE;
+}
+
+gboolean
+mono_threads_suspend_begin_async_resume (MonoThreadInfo *info)
+{
+	return TRUE;
+}
+
+void
+mono_threads_suspend_abort_syscall (MonoThreadInfo *info)
+{
+}
+
+#endif /* USE_GEX_BACKEND */

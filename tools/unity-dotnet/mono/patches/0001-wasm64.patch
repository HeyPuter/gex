@@ -1,6 +1,23 @@
 .globl get_wasm_stack_low
 .globl get_wasm_stack_high
 
+#ifdef __wasm64__
+/* gex: wasm64 (memory64): addresses are i64 */
+get_wasm_stack_low:
+  .functype get_wasm_stack_low () -> (i64)
+  global.get __stack_low@GOT
+  // align up to 16 bytes
+  i64.const 0xF
+  i64.add
+  i64.const -0x10
+  i64.and
+  end_function
+
+get_wasm_stack_high:
+  .functype get_wasm_stack_high () -> (i64)
+  global.get __stack_high@GOT
+  end_function
+#else
 get_wasm_stack_low:
   .functype get_wasm_stack_low () -> (i32)
   global.get __stack_low@GOT
@@ -15,3 +32,4 @@ get_wasm_stack_high:
   .functype get_wasm_stack_high () -> (i32)
   global.get __stack_high@GOT
   end_function
+#endif

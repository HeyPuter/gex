+/**
+ * \file
+ * gex (noita-wasm docs/unity-dotnet.md): Mono as wasm64 inside an x86-64
+ * Linux guest. Threads are POSIX threads (mono-threads-posix.c, musl's
+ * pthreads over gex-kernel's clone and futex); suspension is cooperative
+ * only, as on every wasm host: no signal can interrupt wasm code.
+ */
+
+#include "config.h"
+
+#include <mono/utils/mono-threads.h>
+#include <mono/utils/mono-threads-coop.h>

diff --git a/src/mono/mono/mini/interp/transform.c b/src/mono/mono/mini/interp/transform.c
index 98dfc77ca..f35f8313e 100644
--- a/src/mono/mono/mini/interp/transform.c
+++ b/src/mono/mono/mini/interp/transform.c
@@ -2867,6 +2867,22 @@ is_scalar_vtype (MonoType *type)
 static gboolean
 interp_type_as_ptr (MonoType *tp)
 {
+#if defined(HOST_WASM) && SIZEOF_VOID_P == 8
+	/* gex wasm64: the fast icall path calls through a C type whose arguments are all gpointer (i64).
+	 * Only types whose wasm value type is i64 may take it; an int32 is i32 in the callee's signature. */
+	if (MONO_TYPE_IS_POINTER (tp) || MONO_TYPE_IS_REFERENCE (tp))
+		return TRUE;
+	switch (tp->type) {
+	case MONO_TYPE_I: case MONO_TYPE_U: case MONO_TYPE_I8: case MONO_TYPE_U8: case MONO_TYPE_FNPTR:
+		return TRUE;
+	case MONO_TYPE_VALUETYPE:
+		if (m_class_is_enumtype (m_type_data_get_klass_unchecked (tp)))
+			return interp_type_as_ptr (mono_class_enum_basetype_internal (m_type_data_get_klass_unchecked (tp)));
+		return is_scalar_vtype (tp);
+	default:
+		return FALSE;
+	}
+#endif
 	if (MONO_TYPE_IS_POINTER (tp))
 		return TRUE;
 	if (MONO_TYPE_IS_REFERENCE (tp))
diff --git a/src/mono/mono/utils/mono-threads-wasm.S b/src/mono/mono/utils/mono-threads-wasm.S
index 8752b03f1..186f92830 100644
--- a/src/mono/mono/utils/mono-threads-wasm.S
+++ b/src/mono/mono/utils/mono-threads-wasm.S
@@ -1,6 +1,23 @@
 .globl get_wasm_stack_low
 .globl get_wasm_stack_high
 
+#ifdef __wasm64__
+/* gex: wasm64 (memory64): addresses are i64 */
+get_wasm_stack_low:
+  .functype get_wasm_stack_low () -> (i64)
+  global.get __stack_low@GOT
+  // align up to 16 bytes
+  i64.const 0xF
+  i64.add
+  i64.const -0x10
+  i64.and
+  end_function
+
+get_wasm_stack_high:
+  .functype get_wasm_stack_high () -> (i64)
+  global.get __stack_high@GOT
+  end_function
+#else
 get_wasm_stack_low:
   .functype get_wasm_stack_low () -> (i32)
   global.get __stack_low@GOT
@@ -15,3 +32,4 @@ get_wasm_stack_high:
   .functype get_wasm_stack_high () -> (i32)
   global.get __stack_high@GOT
   end_function
+#endif

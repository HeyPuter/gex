diff --git a/src/mono/mono/mini/interp/interp.c b/src/mono/mono/mini/interp/interp.c
index 31c606007..d0aa3491b 100644
--- a/src/mono/mono/mini/interp/interp.c
+++ b/src/mono/mono/mini/interp/interp.c
@@ -5148,6 +5148,285 @@ typedef struct {
 } WasmPInvokeCacheData;
 #endif
 
+#ifdef HOST_GEX
+/*
+ * gex (noita-wasm docs/unity-dotnet.md): a native function pointer may be a
+ * guest (x86-64) address -- an internal call the guest registered, a P/Invoke
+ * resolved in the guest, a function pointer the guest handed over. Such a call
+ * is made by the guest's calling convention, through the provider's guest-call
+ * primitive (tools/unity-dotnet/provider/gexprov64.c), whose layout this
+ * mirrors. A guest that raises a managed exception (mono_raise_exception) from
+ * inside abandons its frames back to here; the exception becomes pending.
+ */
+typedef struct {
+	guint64 ireg [6];
+	guint64 xmm [8];
+	unsigned nireg, nxmm;
+	const guint64 *stack;
+	unsigned nstack;
+	int win64;
+	guint64 rax, rdx, xmm0, xmm1;
+} GexGuestCall;
+
+int gexp_is_guest_fn (guint64 p);
+guint64 gexp_call_guest_catching (guint64 fn, GexGuestCall *c);
+/* The guest's convention: Win64 in an NT process (set by the provider). */
+int gex_guest_abi_win64;
+
+#define GEX_MAX_STACK_ARGS 64
+
+typedef struct {
+	GexGuestCall c;
+	guint64 stack [GEX_MAX_STACK_ARGS];
+	int ni, nx;
+} GexArgs;
+
+static void
+gex_push_stack (GexArgs *a, guint64 v)
+{
+	g_assert (a->c.nstack < GEX_MAX_STACK_ARGS);
+	a->stack [a->c.nstack++] = v;
+}
+
+static void
+gex_add_int (GexArgs *a, guint64 v)
+{
+	if (a->c.win64) {
+		int pos = a->ni + a->nx;
+		if (pos < 4)
+			a->c.ireg [pos] = v, a->c.nireg = pos + 1;
+		else
+			gex_push_stack (a, v);
+		a->ni++;
+		return;
+	}
+	if (a->ni < 6)
+		a->c.ireg [a->ni++] = v, a->c.nireg = a->ni;
+	else
+		gex_push_stack (a, v);
+}
+
+static void
+gex_add_sse (GexArgs *a, guint64 v)
+{
+	if (a->c.win64) {
+		int pos = a->ni + a->nx;
+		if (pos < 4) {
+			a->c.xmm [pos] = v;
+			if ((unsigned)pos + 1 > a->c.nxmm)
+				a->c.nxmm = pos + 1;
+		} else {
+			gex_push_stack (a, v);
+		}
+		a->nx++;
+		return;
+	}
+	if (a->nx < 8)
+		a->c.xmm [a->nx++] = v, a->c.nxmm = a->nx;
+	else
+		gex_push_stack (a, v);
+}
+
+enum { GEX_NONE, GEX_INT, GEX_SSE };
+
+/* SysV's classification of the eightbytes of a struct of at most 16 bytes. */
+static void
+gex_classify (MonoClass *klass, int base, int cls [2])
+{
+	gpointer iter = NULL;
+	MonoClassField *f;
+	mono_class_init_internal (klass);
+	while ((f = mono_class_get_fields_internal (klass, &iter))) {
+		if (f->type->attrs & FIELD_ATTRIBUTE_STATIC)
+			continue;
+		int off = base + m_field_get_offset (f) - MONO_ABI_SIZEOF (MonoObject);
+		MonoType *t = mini_get_underlying_type (f->type);
+		if (MONO_TYPE_ISSTRUCT (t)) {
+			gex_classify (mono_class_from_mono_type_internal (t), off, cls);
+			continue;
+		}
+		int k = off / 8;
+		if (k < 0 || k > 1)
+			continue;
+		if (t->type == MONO_TYPE_R4 || t->type == MONO_TYPE_R8) {
+			if (cls [k] == GEX_NONE)
+				cls [k] = GEX_SSE;
+		} else {
+			cls [k] = GEX_INT;
+		}
+	}
+}
+
+static int
+gex_struct_size (MonoType *t, MonoMethodSignature *sig)
+{
+	MonoClass *klass = mono_class_from_mono_type_internal (t);
+	if (sig->pinvoke && !sig->marshalling_disabled)
+		return mono_class_native_size (klass, NULL);
+	return mono_class_value_size (klass, NULL);
+}
+
+static void
+gex_add_struct (GexArgs *a, MonoType *t, MonoMethodSignature *sig, guint8 *data)
+{
+	int size = gex_struct_size (t, sig);
+	if (a->c.win64) {
+		if (size == 1 || size == 2 || size == 4 || size == 8) {
+			guint64 v = 0;
+			memcpy (&v, data, size);
+			gex_add_int (a, v);
+		} else {
+			/* By reference to a copy: the interpreter's slot is already one. */
+			gex_add_int (a, (guint64)(gsize)data);
+		}
+		return;
+	}
+	int n8 = (size + 7) / 8;
+	int cls [2] = { GEX_NONE, GEX_NONE };
+	if (size <= 16)
+		gex_classify (mono_class_from_mono_type_internal (t), 0, cls);
+	int nint = 0, nsse = 0;
+	for (int k = 0; k < n8 && size <= 16; k++)
+		cls [k] == GEX_SSE ? nsse++ : nint++;
+	if (size > 16 || a->ni + nint > 6 || a->nx + nsse > 8) {
+		for (int k = 0; k < n8; k++) {
+			guint64 v = 0;
+			memcpy (&v, data + 8 * k, MIN (8, size - 8 * k));
+			gex_push_stack (a, v);
+		}
+		return;
+	}
+	for (int k = 0; k < n8; k++) {
+		guint64 v = 0;
+		memcpy (&v, data + 8 * k, MIN (8, size - 8 * k));
+		if (cls [k] == GEX_SSE)
+			gex_add_sse (a, v);
+		else
+			gex_add_int (a, v);
+	}
+}
+
+static void
+gex_add_arg (GexArgs *a, MonoType *t, MonoMethodSignature *sig, stackval *sv)
+{
+	if (m_type_is_byref (t)) {
+		gex_add_int (a, (guint64)(gsize)sv->data.p);
+		return;
+	}
+	t = mini_get_underlying_type (t);
+	switch (t->type) {
+	case MONO_TYPE_R4: {
+		guint64 v = 0;
+		memcpy (&v, &sv->data.f_r4, 4);
+		gex_add_sse (a, v);
+		break;
+	}
+	case MONO_TYPE_R8: {
+		guint64 v;
+		memcpy (&v, &sv->data.f, 8);
+		gex_add_sse (a, v);
+		break;
+	}
+	case MONO_TYPE_I1: gex_add_int (a, (guint64)(gint64)(gint8)sv->data.i); break;
+	case MONO_TYPE_U1: case MONO_TYPE_BOOLEAN: gex_add_int (a, (guint8)sv->data.i); break;
+	case MONO_TYPE_I2: gex_add_int (a, (guint64)(gint64)(gint16)sv->data.i); break;
+	case MONO_TYPE_U2: case MONO_TYPE_CHAR: gex_add_int (a, (guint16)sv->data.i); break;
+	case MONO_TYPE_I4: gex_add_int (a, (guint64)(gint64)sv->data.i); break;
+	case MONO_TYPE_U4: gex_add_int (a, (guint32)sv->data.i); break;
+	case MONO_TYPE_VALUETYPE:
+	case MONO_TYPE_GENERICINST:
+	case MONO_TYPE_TYPEDBYREF:
+		if (MONO_TYPE_ISSTRUCT (t)) {
+			gex_add_struct (a, t, sig, (guint8 *)sv);
+			break;
+		}
+		/* fall through */
+	default:
+		gex_add_int (a, (guint64)sv->data.l);
+		break;
+	}
+}
+
+/* Call the guest function `addr` with the arguments the interpreter frame
+ * holds by `sig`, and store its result as the frame's return value. */
+static void
+gex_interp_call_guest (MonoMethodSignature *sig, gpointer addr, InterpFrame *frame)
+{
+	GexArgs a;
+	memset (&a, 0, sizeof (a));

diff --git a/src/mono/mono/metadata/sgen-stw.c b/src/mono/mono/metadata/sgen-stw.c
index b7f15460e..2eebcbb12 100644
--- a/src/mono/mono/metadata/sgen-stw.c
+++ b/src/mono/mono/metadata/sgen-stw.c
@@ -390,6 +390,18 @@ unified_suspend_stop_world (MonoThreadInfoFlags flags, unified_suspend_thread_st
 				continue;
 			}
 
+#ifdef HOST_GEX
+			/* gex: a stop-the-world that keeps restarting a thread still in a critical location: say why, once. */
+			if (sleep_duration == 20000) {
+				MonoThreadUnwindState *st = mono_thread_info_get_suspend_state (info);
+				g_warning ("gex STW: thread %p still critical: platform %d inside %d gc %d domain %p sp %p ip %p stack [%p, %p) state %d",
+					mono_thread_info_get_tid (info), mono_threads_platform_in_critical_region (info),
+					info->client_info.info.inside_critical_region, info->client_info.in_critical_region,
+					st->unwind_data [MONO_UNWIND_DATA_DOMAIN], MONO_CONTEXT_GET_SP (&st->ctx),
+					MONO_CONTEXT_GET_IP (&st->ctx), info->client_info.info.stack_start_limit, info->client_info.info.stack_end,
+					mono_thread_info_current_state (info));
+			}
+#endif
 			suspend_count = mono_thread_info_suspend_count (info);
 			if (!(suspend_count == 1))
 				g_error ("[%p] suspend_count = %d, but should be 1", mono_thread_info_get_tid (info), suspend_count);
diff --git a/src/mono/mono/utils/mono-threads-gex.c b/src/mono/mono/utils/mono-threads-gex.c
index 0036d0da9..8d5dfb7de 100644
--- a/src/mono/mono/utils/mono-threads-gex.c
+++ b/src/mono/mono/utils/mono-threads-gex.c
@@ -28,10 +28,25 @@ mono_threads_suspend_init (void)
  * of its guest stack. */
 void gexp_thread_guest_info (guint64 *ctx, guint64 *stack_end);
 
+#include <stdlib.h>
+#include <stdio.h>
+#include <unistd.h>
+#include <sys/syscall.h>
+
 void
 mono_threads_suspend_register (MonoThreadInfo *info)
 {
 	gexp_thread_guest_info (&info->gex_ctx, &info->gex_stack_end);
+	/* GEXMONO_TRACE_THREADS=1: each thread as it registers, with the C stack Mono will check its saved
+	 * states against. */
+	static int trace = -1;
+	if (trace < 0)
+		trace = getenv ("GEXMONO_TRACE_THREADS") != NULL;
+	if (trace) {
+		int here;
+		fprintf (stderr, "[gexmono] thread %ld (%p) registers: stack [%p, %p), sp %p\n", (long)syscall (SYS_gettid),
+			(void *)mono_thread_info_get_tid (info), info->stack_start_limit, info->stack_end, (void *)&here);
+	}
 }
 

diff --git a/src/mono/mono/mini/mini-wasm-gex.h b/src/mono/mono/mini/mini-wasm-gex.h
new file mode 100644
index 000000000..c0db27921
--- /dev/null
+++ b/src/mono/mono/mini/mini-wasm-gex.h
@@ -0,0 +1,73 @@
+/**
+ * \file
+ * The runtime wasm JIT under gex (noita-wasm docs/unity-dotnet.md P5): what
+ * the browser build gets from emscripten and from JS, here from the C library
+ * and from gex host imports (the provider's `gex.provider_jit_*`). Mono runs
+ * as a gex stateful provider: a wasm64 module with a 64-bit memory and a
+ * table64, instantiated once per guest thread; a JIT module is instantiated
+ * into each thread's store as the browser instantiates one per worker.
+ */
+#ifndef __MONO_MINI_WASM_GEX_H__
+#define __MONO_MINI_WASM_GEX_H__
+
+#include <stdint.h>
+#include <time.h>
+#include <stdio.h>
+
+#define EMSCRIPTEN_KEEPALIVE __attribute__((used))
+
+static inline double
+emscripten_get_now (void)
+{
+	struct timespec ts;
+	clock_gettime (CLOCK_MONOTONIC, &ts);
+	return ts.tv_sec * 1000.0 + ts.tv_nsec / 1e6;
+}
+
+/* ---- gex host imports (shims/native libprov.rs; later the page's gex.mjs) ---- */
+
+#define WJ_GEX_IMPORT(n) __attribute__((import_module ("gex"), import_name (n)))
+
+/* Compile `bytes` (cached process-wide by content) and instantiate it into
+ * THIS thread's store, as the browser's `new WebAssembly.Instance` on one
+ * worker. Its imports: m.h the guest memory, f.f this store's function table,
+ * s.p this thread's provider __stack_pointer, s.<consts_names[k]> = consts[k]
+ * (each as the global type the module declares), h.<index> = table[index].
+ * Then, for each k < n, table[slots[k]] = the export named by the k-th
+ * NUL-terminated string in `names`. 1, or 0 with the reason in errbuf. */
+WJ_GEX_IMPORT ("provider_jit_instantiate") int
+gexwj_host_instantiate (const void *bytes, uint64_t len, const char *consts_names, const uint64_t *consts, uint64_t nconsts,
+	const int64_t *slots, const char *names, uint64_t n, char *errbuf, uint64_t errcap);
+
+/* This store's table. GEXWJ_TABLE_REAL: 1 if this store installed a function
+ * at a (written again, which repairs an overwrite), 0 if it installed none. GEXWJ_TABLE_ALIAS: table[a] = table[b] (recorded as installed).
+ * GEXWJ_TABLE_ARITY: the parameter count of table[a]'s function, -1 if
+ * null. */
+/* The names of the s.* globals, in the order of the consts array. */
+#define GEXWJ_CONST_NAMES "l\0c\0v\0n\0d\0m\0b\0i\0g\0"
+
+#define GEXWJ_TABLE_REAL 0
+#define GEXWJ_TABLE_ALIAS 1
+#define GEXWJ_TABLE_ARITY 2
+WJ_GEX_IMPORT ("provider_jit_table") int64_t gexwj_host_table (int op, int64_t a, int64_t b);
+
+/* Reserve n slots of the process's function table, every store's filled
+ * with table[fill] (in this store): the first index, or 0. */
+WJ_GEX_IMPORT ("provider_jit_reserve") int64_t gexwj_host_reserve (int64_t n, int64_t fill);
+
+/* This thread's provider C stack (gexprov64.h): [lo, lo + 1 MiB). */
+WJ_GEX_IMPORT ("provider_stack") uint64_t gexwj_host_stack (void);
+#define GEXWJ_STACK_SIZE (1ul << 20)
+
+static inline uintptr_t emscripten_stack_get_end (void) { return (uintptr_t) gexwj_host_stack (); }
+static inline uintptr_t emscripten_stack_get_base (void) { return (uintptr_t) gexwj_host_stack () + GEXWJ_STACK_SIZE; }
+static inline uintptr_t __attribute__((noinline)) emscripten_stack_get_current (void) { volatile char here; return (uintptr_t) &here; }
+
+/* The browser's main-thread setInterval for the tier-2 / edge samplers: a
+ * plain thread calling mono_wasm_jit_edge_tick every `ms` (mini-wasm.c). */
+void gexwj_start_ticker (int ms);
+
+/* A JS stack trace in the browser; nothing to print here. */
+static inline void gexwj_log (const char *line) { fprintf (stderr, "%s\n", line); }
+
+#endif

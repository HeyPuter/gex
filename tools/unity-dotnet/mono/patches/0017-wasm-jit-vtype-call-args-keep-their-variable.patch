@@ -8268,6 +8268,13 @@ mono_wasm_emit_call (MonoCompile *cfg, MonoCallInst *call)
 		if (opcode == OP_VMOVE || opcode == OP_XMOVE) {
 			/* vtype: no carrier — pin the source variable out of SSA instead (see above) */

From: velzie <you@example.com>
Subject: [PATCH] wasm JIT: integer and conversion ops read and write at the register's width; V8 validation failures are final

On wasm64 a vreg that a negative constant also writes is an i64 local. OP_ICONV_TO_R8 loaded its source
with the plain wasm_ld, so `(double)minValue` with minValue = int.MinValue inlined (Unity InputSystem's
NumberHelpers.IntToNormalizedFloat inside InputStateBlock.ReadFloat) emitted f64.convert_i32_s on an
i64 and the module did not validate. The same plain load/store was in INEG, INOT, LNOT, LNEG, the
checked LDIV/LREM family, LCONV_TO_I (wasm64), LCONV_TO_OVF_I4, the switch index and the float->int
saturating conversions' result; all now go through wasm_ld_as / wasm_st_from with the op's own types.
Where the widths already agree the bytes are unchanged (every embed-suite module but ReadFloat has the
same length as before).

The invalid result is meant to be final (0019), but the check matched only V8's "CompileError" name and
wasmtime's "validating the module". In the browser the error text is "WebAssembly.Module(): Compiling
function #N ... failed: ...", so Hollow Knight re-emitted ReadFloat 1195 times (hg25). That text is
final now too.

Test: tests/unity-dotnet T.ReadFloats (a sample reader by format), "readfloats 7507799.7418" as
CoreCLR prints it; run.sh's wasm-JIT legs fail on any WASM_JIT_INVALID.
---
diff --git a/src/mono/mono/mini/mini-wasm-emitter.inc b/src/mono/mono/mini/mini-wasm-emitter.inc
index 3d76c5d70..5fdce820c 100644
--- a/src/mono/mono/mini/mini-wasm-emitter.inc
+++ b/src/mono/mono/mini/mini-wasm-emitter.inc
@@ -4115,27 +4115,27 @@ mono_wasm_emit_method (MonoCompile *cfg)
 #endif
 			case OP_INEG: /* no i32.neg in wasm: 0 - x */
 				wasm_i32_const (&body, 0);
-				if (!wasm_ld (&body, &lc, ins->sreg1)) { fail = "ineg sreg"; goto done; }
+				if (!wasm_ld_as (&body, &lc, ins->sreg1, WASM_I32)) { fail = "ineg sreg"; goto done; }
 				wasm_op (&body, WASM_OP_I32_SUB);
-				if (!wasm_st (&body, &lc, ins->dreg)) { fail = "ineg dreg"; goto done; }
+				if (!wasm_st_from (&body, &lc, ins->dreg, WASM_I32)) { fail = "ineg dreg"; goto done; }
 				break;
 			case OP_INOT: /* no i32.not in wasm: x ^ -1 */
-				if (!wasm_ld (&body, &lc, ins->sreg1)) { fail = "inot sreg"; goto done; }
+				if (!wasm_ld_as (&body, &lc, ins->sreg1, WASM_I32)) { fail = "inot sreg"; goto done; }
 				wasm_i32_const (&body, -1);
 				wasm_op (&body, WASM_OP_I32_XOR);
-				if (!wasm_st (&body, &lc, ins->dreg)) { fail = "inot dreg"; goto done; }
+				if (!wasm_st_from (&body, &lc, ins->dreg, WASM_I32)) { fail = "inot dreg"; goto done; }
 				break;
 			case OP_LNOT: /* no i64.not in wasm: x ^ -1 */
-				if (!wasm_ld (&body, &lc, ins->sreg1)) { fail = "lnot sreg"; goto done; }
+				if (!wasm_ld_as (&body, &lc, ins->sreg1, WASM_I64)) { fail = "lnot sreg"; goto done; }
 				wasm_i64_const (&body, (gint64) -1);
 				wasm_op (&body, WASM_OP_I64_XOR);
-				if (!wasm_st (&body, &lc, ins->dreg)) { fail = "lnot dreg"; goto done; }
+				if (!wasm_st_from (&body, &lc, ins->dreg, WASM_I64)) { fail = "lnot dreg"; goto done; }
 				break;
 			case OP_LNEG: /* no i64.neg in wasm: 0 - x */
 				wasm_i64_const (&body, (gint64) 0);
-				if (!wasm_ld (&body, &lc, ins->sreg1)) { fail = "lneg sreg"; goto done; }
+				if (!wasm_ld_as (&body, &lc, ins->sreg1, WASM_I64)) { fail = "lneg sreg"; goto done; }
 				wasm_op (&body, WASM_OP_I64_SUB);
-				if (!wasm_st (&body, &lc, ins->dreg)) { fail = "lneg dreg"; goto done; }
+				if (!wasm_st_from (&body, &lc, ins->dreg, WASM_I64)) { fail = "lneg dreg"; goto done; }
 				break;
 			case OP_LADD: BIN (WASM_OP_I64_ADD); break;
 			case OP_LSUB: BIN (WASM_OP_I64_SUB); break;
@@ -4159,17 +4159,17 @@ mono_wasm_emit_method (MonoCompile *cfg)
 				if (ldiv_rti < 0) { if (nextra >= WJ_EXTRA_TYPES_MAX) { fail = "too many callee types"; goto done; } extra_types [nextra] = rt; ldiv_rti = ti_base + nextra++; }
 				uses_calls = TRUE;
 				/* divide-by-zero: if (sreg2 == 0) raise DivideByZeroException (exc_id 1) */
-				if (!wasm_ld (&body, &lc, ins->sreg2)) { fail = "ldiv b"; goto done; }
+				if (!wasm_ld_as (&body, &lc, ins->sreg2, WASM_I64)) { fail = "ldiv b"; goto done; }
 				wasm_op (&body, WASM_OP_I64_EQZ);
 				wasm_op (&body, WASM_OP_IF); wasm_u8 (&body, 0x40);
 				LDIV_RAISE (1);
 				wasm_op (&body, WASM_OP_END);
 				if (lsigned) {
 					/* overflow: if (sreg1 == INT64_MIN && sreg2 == -1) raise OverflowException (exc_id 0) */
-					if (!wasm_ld (&body, &lc, ins->sreg1)) { fail = "ldiv a"; goto done; }
+					if (!wasm_ld_as (&body, &lc, ins->sreg1, WASM_I64)) { fail = "ldiv a"; goto done; }
 					wasm_i64_const (&body, (gint64) G_MININT64);
 					wasm_op (&body, WASM_OP_I64_EQ);
-					if (!wasm_ld (&body, &lc, ins->sreg2)) { fail = "ldiv b2"; goto done; }
+					if (!wasm_ld_as (&body, &lc, ins->sreg2, WASM_I64)) { fail = "ldiv b2"; goto done; }
 					wasm_i64_const (&body, (gint64) -1);
 					wasm_op (&body, WASM_OP_I64_EQ);
 					wasm_op (&body, WASM_OP_I32_AND);
@@ -4178,9 +4178,9 @@ mono_wasm_emit_method (MonoCompile *cfg)
 					wasm_op (&body, WASM_OP_END);
 				}
 				/* the checked division */
-				if (!wasm_ld (&body, &lc, ins->sreg1) || !wasm_ld (&body, &lc, ins->sreg2)) { fail = "ldiv sreg"; goto done; }
+				if (!wasm_ld_as (&body, &lc, ins->sreg1, WASM_I64) || !wasm_ld_as (&body, &lc, ins->sreg2, WASM_I64)) { fail = "ldiv sreg"; goto done; }
 				wasm_op (&body, dop);
-				if (!wasm_st (&body, &lc, ins->dreg)) { fail = "ldiv dreg"; goto done; }
+				if (!wasm_st_from (&body, &lc, ins->dreg, WASM_I64)) { fail = "ldiv dreg"; goto done; }
 				break;
 			}
 			case OP_LAND: BIN (WASM_OP_I64_AND); break;
@@ -4229,9 +4229,9 @@ mono_wasm_emit_method (MonoCompile *cfg)
 				if (!wasm_st (&body, &lc, ins->dreg)) { fail = "rconv_to_r4 dreg"; goto done; }
 				break;
 			case OP_ICONV_TO_R8:
-				if (!wasm_ld (&body, &lc, ins->sreg1)) { fail = "conv sreg"; goto done; }
+				if (!wasm_ld_as (&body, &lc, ins->sreg1, WASM_I32)) { fail = "conv sreg"; goto done; }
 				wasm_op (&body, WASM_OP_F64_CONVERT_I32_S);
-				if (!wasm_st (&body, &lc, ins->dreg)) { fail = "conv dreg"; goto done; }
+				if (!wasm_st_from (&body, &lc, ins->dreg, WASM_F64)) { fail = "conv dreg"; goto done; }
 				break;
 			case OP_RCONV_TO_R8: UN (WASM_OP_F64_PROMOTE_F32); break;     /* f32 -> f64 */
 			case OP_FCONV_TO_R4: UN (WASM_OP_F32_DEMOTE_F64); break;      /* f64 -> f32 */
@@ -4255,8 +4255,8 @@ mono_wasm_emit_method (MonoCompile *cfg)
 				break;
 #if WJ_W64
 			case OP_LCONV_TO_I: case OP_LCONV_TO_U:   /* i64 -> native int: the same width on wasm64 */
-				if (!wasm_ld (&body, &lc, ins->sreg1)) { fail = "conv sreg"; goto done; }
-				if (!wasm_st (&body, &lc, ins->dreg)) { fail = "conv dreg"; goto done; }
+				if (!wasm_ld_as (&body, &lc, ins->sreg1, WASM_I64)) { fail = "conv sreg"; goto done; }
+				if (!wasm_st_from (&body, &lc, ins->dreg, WASM_I64)) { fail = "conv dreg"; goto done; }
 				break;
 #else
 			case OP_LCONV_TO_I: case OP_LCONV_TO_U: UN (WASM_OP_I32_WRAP_I64); break;  /* i64 -> native-int (truncate) */
@@ -4266,20 +4266,20 @@ mono_wasm_emit_method (MonoCompile *cfg)
 				 * read as u64): out of range iff x >u 0x7fffffff -- decompose.c's two comparisons, one each. */
 				gboolean _un = ins->opcode == OP_LCONV_TO_OVF_I4_UN || ins->opcode == OP_LCONV_TO_OVF_I_UN;
 				if (!WJ_HAS_THROW (0)) { fail = "no shared throw block for ovf conv"; goto done; }
-				if (!wasm_ld (&body, &lc, ins->sreg1)) { fail = "ovf conv sreg"; goto done; }
+				if (!wasm_ld_as (&body, &lc, ins->sreg1, WASM_I64)) { fail = "ovf conv sreg"; goto done; }
 				if (_un) {
 					wasm_i64_const (&body, 0x7fffffff);
 					wasm_op (&body, WASM_OP_I64_GT_U);
 				} else {
-					if (!wasm_ld (&body, &lc, ins->sreg1)) { fail = "ovf conv sreg"; goto done; }
+					if (!wasm_ld_as (&body, &lc, ins->sreg1, WASM_I64)) { fail = "ovf conv sreg"; goto done; }
 					wasm_op (&body, WASM_OP_I32_WRAP_I64);
 					wasm_op (&body, WASM_OP_I64_EXTEND_I32_S);
 					wasm_op (&body, WASM_OP_I64_NE);
 				}
 				WJ_THROW_BR (0, 0);
-				if (!wasm_ld (&body, &lc, ins->sreg1)) { fail = "ovf conv sreg"; goto done; }
+				if (!wasm_ld_as (&body, &lc, ins->sreg1, WASM_I64)) { fail = "ovf conv sreg"; goto done; }
 				wasm_op (&body, WASM_OP_I32_WRAP_I64);
-				if (!wasm_st (&body, &lc, ins->dreg)) { fail = "ovf conv dreg"; goto done; }
+				if (!wasm_st_from (&body, &lc, ins->dreg, WASM_I32)) { fail = "ovf conv dreg"; goto done; }
 				wj_count (WJC_OVF_CONV_LOWERED);
 				break;
 			}
@@ -4311,7 +4311,7 @@ mono_wasm_emit_method (MonoCompile *cfg)
 				if (!wasm_ld (&body, &lc, ins->sreg1)) { fail = "fconv sreg"; goto done; } \
 				wasm_op_sat (&body, _f32 ? (SAT32) : (SAT64)); \
 				NARROW; \
-				if (!wasm_st (&body, &lc, ins->dreg)) { fail = "fconv dreg"; goto done; } \
+				if (!wasm_st_from (&body, &lc, ins->dreg, ((SAT32) == WASM_SAT_I64_TRUNC_F32_S || (SAT32) == WASM_SAT_I64_TRUNC_F32_U) ? WASM_I64 : WASM_I32)) { fail = "fconv dreg"; goto done; } \
 			} while (0)
 			#define SAT_NONE   do { } while (0)
 			#define SAT_EXT8   wasm_op (&body, WASM_OP_I32_EXTEND8_S)
@@ -4999,7 +4999,7 @@ mono_wasm_emit_method (MonoCompile *cfg)
 				guint nsw = GPOINTER_TO_UINT (ins->klass), si;
 				if (nsw == 0) { fail = "switch no targets"; goto done; }
 				for (si = 0; si + 1 < nsw; ++si) {
-					if (!wasm_ld (&body, &lc, ins->sreg1)) { fail = "switch idx"; goto done; }
+					if (!wasm_ld_as (&body, &lc, ins->sreg1, WASM_I32)) { fail = "switch idx"; goto done; }
 					wasm_i32_const (&body, (gint32) si);
 					wasm_op (&body, WASM_OP_I32_EQ);
 					wasm_op (&body, WASM_OP_IF); wasm_u8 (&body, 0x40);
@@ -8045,7 +8045,10 @@ vcall_cold_miss_emit:
 				 * Everything else stays retriable, which is the case R245 Stage 2c added this for: an
 				 * OOM or a LinkError is a property of THIS worker at THIS moment (imports are per-worker,
 				 * memory pressure is transient), and re-emitting elsewhere succeeds.R289. */
-				{ gboolean _perm = ierr [0] && (strstr (ierr, "CompileError") != NULL || strstr (ierr, "validating the module") != NULL);   /* V8 / wasmtime: the bytes do not validate */
+				{ gboolean _perm = ierr [0] && (strstr (ierr, "CompileError") != NULL || strstr (ierr, "validating the module") != NULL
+				                                || strstr (ierr, "Compiling function") != NULL);
+				  /* the bytes do not validate: V8's CompileError, the bare V8 message the page hands back
+				   * ("WebAssembly.Module(): Compiling function #N ... failed: ..."), wasmtime's wording */
 				  cfg->wasm_jit_result.retriable = _perm ? 0 : 1;
 				  if (G_UNLIKELY (mono_wasm_jit_stats) && _perm) mono_wasm_jit_count (WJC_INVALID_PERM); }
 				g_free (cached);

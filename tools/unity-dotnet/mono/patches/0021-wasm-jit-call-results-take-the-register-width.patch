From: velzie <you@example.com>
Subject: [PATCH] wasm JIT: call results are stored at the register's width

A call's wasm result is the callee's own type (i32 for an int return), but the dreg it lands in can be
an i64 local when the same vreg is also written by a 64-bit def. The result stores after direct,
AOT, late-bound, residual, register-indirect and every virtual-call route (wj_vc_store_result) used
the plain wasm_st, so such a module failed validation ("expected i64, found i32") and the method
stayed on the interpreter. Seen at threshold 10 in UTF8Encoding.GetChars and GetCharsCommon (a
virtual call through the inline cache). They now go through wasm_st_from with the call's return
type, which extends or wraps to the register's width.

Test: tests/unity-dotnet/embed/run.sh's threshold-10 leg, which also requires invalid=0.
---
diff --git a/src/mono/mono/mini/mini-wasm-emitter.inc b/src/mono/mono/mini/mini-wasm-emitter.inc
index 960e69cf9..3d76c5d70 100644
--- a/src/mono/mono/mini/mini-wasm-emitter.inc
+++ b/src/mono/mono/mini/mini-wasm-emitter.inc
@@ -5223,7 +5223,7 @@ mono_wasm_emit_method (MonoCompile *cfg)
 					if (ct.ret != WASM_VOID) {
 						if (cci.ret.kind == WJ_ARG_VTYPE_SCALAR) {
 							if (!wj_store_scalar_vtype_result (&body, &lc, ct.ret, wj_arg_vreg (call, cci.nargs))) { fail = "call scalar-vtype ret"; goto done; }
-						} else if (!wasm_st (&body, &lc, ins->dreg)) { fail = "call dreg"; goto done; }
+						} else if (!wasm_st_from (&body, &lc, ins->dreg, ct.ret)) { fail = "call dreg"; goto done; }
 					}
 				}
 #ifdef WJ_RUNTIME
@@ -5320,7 +5320,7 @@ mono_wasm_emit_method (MonoCompile *cfg)
 								if (ct.ret == WASM_I32) wasm_emit_subword_ret_norm (&body, csig->ret);   /* raw AOT body: dirty upper bits */
 									if (cci.ret.kind == WJ_ARG_VTYPE_SCALAR) {
 										if (!wj_store_scalar_vtype_result (&body, &lc, ct.ret, wj_arg_vreg (call, cci.nargs))) { fail = "aot scalar-vtype ret"; goto done; }
-									} else if (!wasm_st (&body, &lc, ins->dreg)) { fail = "call dreg"; goto done; }
+									} else if (!wasm_st_from (&body, &lc, ins->dreg, ct.ret)) { fail = "call dreg"; goto done; }
 								}
 							}
 							{ extern int mono_wasm_jit_verbose; static int n_il = 0; if (mono_wasm_jit_verbose >= 2 && n_il++ < 128) { char *cn = mono_method_get_full_name (call->method); printf ("WASM_JIT_INLINE_AOT[%d] %s -> %s\n", n_il, mname, cn); g_free (cn); } }
@@ -5495,7 +5495,7 @@ mono_wasm_emit_method (MonoCompile *cfg)
 								if (ct.ret != WASM_VOID) {
 									if (cci.ret.kind == WJ_ARG_VTYPE_SCALAR) {
 										if (!wj_store_scalar_vtype_result (&body, &lc, ct.ret, wj_arg_vreg (call, cci.nargs))) { fail = "late scalar-vtype ret"; goto done; }
-									} else if (!wasm_st (&body, &lc, ins->dreg)) { fail = "late call dreg"; goto done; }
+									} else if (!wasm_st_from (&body, &lc, ins->dreg, ct.ret)) { fail = "late call dreg"; goto done; }
 								}
 							}
 							wasm_op (&body, WASM_OP_BR); wasm_uleb (&body, 1); /* -> $after_residual */
@@ -5627,7 +5627,7 @@ mono_wasm_emit_method (MonoCompile *cfg)
 						}
 						if (cci.ret.kind == WJ_ARG_VTYPE_SCALAR) {
 							if (!wj_store_scalar_vtype_result (&body, &lc, ct.ret, wj_arg_vreg (call, cci.nargs))) { fail = "residual scalar-vtype ret"; goto done; }
-						} else if (!wasm_st (&body, &lc, ins->dreg)) { fail = "residual dreg"; goto done; }
+						} else if (!wasm_st_from (&body, &lc, ins->dreg, ct.ret)) { fail = "residual dreg"; goto done; }
 					}
 					if (late_fslot_block)
 						wasm_op (&body, WASM_OP_END); /* $after_residual */
@@ -7441,7 +7441,7 @@ vcall_cold_miss_emit:
 				if (!wasm_ld_as (&body, &lc, ins->sreg1, is_membase ? WASM_PTR : WASM_I32)) { fail = "creg target ld"; goto done; }
 					if (is_membase) { WJ_NEG_OFFSET_ADD (ins->inst_offset); wasm_op (&body, WASM_OP_I32_LOAD); wasm_memarg (&body, 2, WJ_MEMARG_OFFSET (ins->inst_offset)); } /* target = *(base + offset) */
 				wj_emit_dynamic_call (&body, (guint32) type_idx);
-				if (ct.ret != WASM_VOID && !wasm_st (&body, &lc, ins->dreg)) { fail = "creg dreg"; goto done; }
+				if (ct.ret != WASM_VOID && !wasm_st_from (&body, &lc, ins->dreg, ct.ret)) { fail = "creg dreg"; goto done; }
 				break;
 			}
 			default:
diff --git a/src/mono/mono/mini/mini-wasm-ir.inc b/src/mono/mono/mini/mini-wasm-ir.inc
index 603bf32e8..7d398b75c 100644
--- a/src/mono/mono/mini/mini-wasm-ir.inc
+++ b/src/mono/mono/mini/mini-wasm-ir.inc
@@ -2119,7 +2119,7 @@ wj_vc_store_result (WasmBuf *body, WjCtx *c, MonoInst *ins, gboolean is_vcall2,
 	if (is_vcall2)
 		return ci->ret.kind == WJ_ARG_VTYPE_SCALAR &&
 			wj_store_scalar_vtype_result (body, c, rv, wj_arg_vreg ((MonoCallInst *) ins, ci->nargs));
-	return wasm_st (body, c, ins->dreg);
+	return wasm_st_from (body, c, ins->dreg, rv);
 }
 
 /* Emit one managed-call arg (index ai over the managed args, incl. `this` at 0 when hasthis).

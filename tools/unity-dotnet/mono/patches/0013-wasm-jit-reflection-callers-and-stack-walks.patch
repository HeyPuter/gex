diff --git a/src/mono/mono/mini/mini-wasm-emitter.inc b/src/mono/mono/mini/mini-wasm-emitter.inc
index 69f04eabb..660e37fce 100644
--- a/src/mono/mono/mini/mini-wasm-emitter.inc
+++ b/src/mono/mono/mini/mini-wasm-emitter.inc
@@ -475,6 +475,10 @@ mono_wasm_emit_method (MonoCompile *cfg)
 		}
 	}
 	if (cfg->gshared) { fail = "gshared method"; goto done; }
+	/* gex: a [DynamicSecurityMethod] (StackCrawlMark) method finds its caller by walking the stack, and
+	 * a JIT-compiled frame is invisible to that walk: Assembly.GetExecutingAssembly compiled here answered
+	 * System.Private.CoreLib. The interpreter keeps these, as transform.c keeps them out of inlining. */
+	if (cfg->method->flags & METHOD_ATTRIBUTE_REQSECOBJ) { fail = "stack-walking method (REQSECOBJ)"; goto done; }
 	/* save_lmf methods (synchronized bodies, some wrappers) lower emit_push_lmf/emit_pop_lmf IR:
 	 * the LMF struct lives behind a VARLOADA'd local (a fixed 8-byte addr-frame slot here — smaller
 	 * than MonoLMF) and its address is PUBLISHED into the thread's LMF chain; an exceptional unwind
@@ -3412,6 +3416,19 @@ mono_wasm_emit_method (MonoCompile *cfg)
 			    !(lazy_ref_frame && terminal_vcall_handoff && ins == terminal_vcall_ins))
 				ENSURE_REF_FRAME ();
 #endif
+			/* gex: a callee that walks the stack to find its caller ([DynamicSecurityMethod] / StackCrawlMark:
+			 * Assembly.GetCallingAssembly, Assembly.Load, Type.GetType(string), ...) cannot see a JIT-compiled
+			 * frame, so it would answer for the interpreter frame below. method_needs_stack_walk's rule, as
+			 * llvm_only + interp applies it (method-to-ir.c): keep such a caller in the interpreter.
+			 * MethodBase.GetCurrentMethod and Assembly.GetExecutingAssembly are intrinsics instead
+			 * (intrinsics.c), so they never reach here as calls. */
+			if (MONO_IS_CALL (ins)) {
+				MonoMethod *_swm = ((MonoCallInst *) ins)->method;
+				if (_swm && ((_swm->flags & METHOD_ATTRIBUTE_REQSECOBJ) ||
+				             (_swm->klass == mono_defaults.systemtype_class && !strcmp (_swm->name, "GetType")))) {
+					fail = "callee needs a stack walk"; goto done;
+				}
+			}
 			switch (ins->opcode) {
 			case OP_NOP: case OP_IL_SEQ_POINT: case OP_SEQ_POINT:
 			case OP_DUMMY_USE: case OP_NOT_REACHED: case OP_START_HANDLER:
@@ -5221,8 +5238,15 @@ mono_wasm_emit_method (MonoCompile *cfg)
 					/* Don't residual reflection methods: running e.g. MonoMethodInfo:get_parameter_info via
 					 * interp_entry while a dynamic type is mid-Finish can re-enter that type's Finish. Bail
 					 * these to the interpreter; keep the rest. */
-					{ const char *_ns = m_class_get_name_space (call->method->klass);
-					  if (_ns && !strncmp (_ns, "System.Reflection", 17)) { fail = "residual reflection"; goto done; } }
+					/* gex: only once a Reflection.Emit image exists. That re-entry needs a dynamic type to
+					 * be mid-Finish, so a process that never made one (a program calling FieldInfo
+					 * through here 145k times a minute)
+					 * kept the interpreter for every such caller for nothing. A method compiled before the
+					 * first dynamic image keeps its residual; IKVM, the workload the refusal was written
+					 * for, creates its dynamic assembly at startup, before anything is hot. */
+					{ extern gboolean mono_dynamic_images_exist (void);
+					  const char *_ns = m_class_get_name_space (call->method->klass);
+					  if (_ns && !strncmp (_ns, "System.Reflection", 17) && mono_dynamic_images_exist ()) { fail = "residual reflection"; goto done; } }
 					/* gex: an InternalCall / P/Invoke into guest code is called from the scratch directly
 					 * (mono_wasm_jit_gex_native_call, interp.c), not through the interpreter: no self-healing
 					 * block (it never gets an f-slot), no pretransform, the same spill and result protocol. */

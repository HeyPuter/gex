+/* How one argument reaches the callee: `t` its type in the managed signature (with `this` first), `handles`
+ * whether the icall takes handles. 0 = unsupported. */
+static guint8
+wj_mono_icall_arg_kind (MonoMethodSignature *csig, int i, gboolean handles)
+{
+	extern gboolean mono_wasm_jit_arg_is_byaddr (MonoType *t);
+	MonoType *t = csig->params [i], *ut, *etype = NULL;
+	if (handles && MONO_TYPE_IS_REFERENCE (t)) {
+		if (mono_signature_param_is_out (csig, i))
+			return WJM_H_OUT;
+		return m_type_is_byref (t) ? WJM_H_INOUT : WJM_H_OBJ;
+	}
+	if (m_type_is_byref (t))
+		return WJM_I64;
+	ut = mini_get_underlying_type (t);
+	switch (ut->type) {
+	case MONO_TYPE_BOOLEAN: case MONO_TYPE_CHAR: case MONO_TYPE_I1: case MONO_TYPE_U1: case MONO_TYPE_I2: case MONO_TYPE_U2:
+	case MONO_TYPE_I4: case MONO_TYPE_U4:
+		return WJM_I32;
+	case MONO_TYPE_I8: case MONO_TYPE_U8: case MONO_TYPE_I: case MONO_TYPE_U: case MONO_TYPE_PTR: case MONO_TYPE_FNPTR:
+	case MONO_TYPE_OBJECT: case MONO_TYPE_STRING: case MONO_TYPE_CLASS: case MONO_TYPE_SZARRAY: case MONO_TYPE_ARRAY:
+		return WJM_I64;
+	case MONO_TYPE_R4:
+		return WJM_R4;
+	case MONO_TYPE_R8:
+		return WJM_R8;
+	case MONO_TYPE_VALUETYPE: case MONO_TYPE_GENERICINST: {
+		gboolean byaddr;
+		if (!m_class_is_valuetype (mono_class_from_mono_type_internal (ut)) || mini_is_gsharedvt_variable_type (ut))
+			return 0;
+		byaddr = mono_wasm_jit_arg_is_byaddr (t);   /* what the JIT spilled: the copy's address, or the value */
+		if (mini_wasm_is_scalar_vtype (ut, &etype) && etype) {
+			/* the C ABI takes the single scalar by value (type_to_c); a float one is miscounted by
+			 * build_args_from_sig, so it keeps the residual like the interpreter's FIXME */
+			MonoType *ue = mini_get_underlying_type (etype);
+			gboolean wide;
+			if (ue->type == MONO_TYPE_R4 || ue->type == MONO_TYPE_R8)
+				return 0;
+			wide = ue->type == MONO_TYPE_I8 || ue->type == MONO_TYPE_U8 || ue->type == MONO_TYPE_I || ue->type == MONO_TYPE_U ||
+				ue->type == MONO_TYPE_PTR || ue->type == MONO_TYPE_FNPTR || MONO_TYPE_IS_REFERENCE (ue);
+			if (byaddr)
+				return wide ? WJM_D64 : WJM_D32;
+			return wide ? WJM_I64 : WJM_I32;
+		}
+		/* a larger struct goes by address on both sides */
+		return byaddr ? WJM_I64 : 0;
+	}
+	default:
+		return 0;
+	}
+}

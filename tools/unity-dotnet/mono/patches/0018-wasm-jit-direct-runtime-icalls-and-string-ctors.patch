+	if (!entry)
+		return NULL;
+	site = g_new0 (WjGexNativeSite, 1);
+	site->sig = sig;
+	site->addr = addr;
+	site->gc_safe = foreign;
+	site->null_check = sig->hasthis;
+	site->mono = 1;
+	site->nargs = (guint8) csig->param_count;
+	site->nint = (guint8) nint;
+	site->nflt = (guint8) nflt;

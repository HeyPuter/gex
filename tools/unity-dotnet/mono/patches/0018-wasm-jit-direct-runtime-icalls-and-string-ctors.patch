+static WjGexNativeSite *
+wj_mono_icall_site (MonoMethod *target, MonoMethodSignature *sig, gpointer addr, gboolean handles, gboolean foreign)
+{
+	extern gpointer mono_wasm_try_get_interp_to_native_trampoline (MonoMethodSignature *sig);
+	MonoImage *img = m_class_get_image (target->klass);
+	MonoMethodSignature *csig, *call_sig;
+	WjGexNativeSite *site;
+	guint8 kinds [17];

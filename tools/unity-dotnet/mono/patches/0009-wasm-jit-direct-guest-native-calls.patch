 	printf ("[wasm-jit vperm top] perm-unjittable vcall-residual callees by executed residual count:\n");
@@ -7122,6 +7123,230 @@ mono_wasm_jit_pretransform (MonoMethod *method)
  * else 0. This is the residual's exception path: real code throws (null checks, class init, ...), and
  * without it the JITted caller would read the stale scratch slot as a garbage object -> OOB.
  */
+/*
+ * gex: DIRECT NATIVE CALLS from wasm-JIT code to guest code (the embedder's InternalCalls and P/Invokes).
+ *
+ * A wasm-JIT body reaches an InternalCall or P/Invoke only through the residual (call_interp -> interp_entry ->
+ * the managed-to-native wrapper's IL -> ves_pinvoke_method -> gex_interp_call_guest): ~490 ns a call in the
+ * browser, against ~60 ns for the interpreter's own call, and an embedder's scripting API can take ~220k such
+ * calls a second. mono_wasm_jit_gex_native_site
+ * decides at compile time whether a callee can instead be called straight from the residual's scratch: the
+ * target is resolved once (it is a guest function), and the wrapper's work is redone here with no interpreter
+ * frame -- the null check of `this`, the GC-safe transition (foreign InternalCalls and P/Invokes, as
+ * gc_safe_transition_builder_init decides on wasm), SetLastError, and the interruption checkpoint the wrapper
+ * ends with, which is what turns an exception the guest raised into a managed throw. Only signatures whose
+ * marshalling is the identity qualify: integers, pointers, byrefs, floats, and, for an InternalCall only,
+ * object references (a P/Invoke would marshal those). By-value structs, struct returns, handles-style
+ * InternalCalls, generic and vararg methods take the residual as before.
+ */
+typedef struct {
+	MonoMethodSignature *sig;
+	gpointer addr;
+	guint8 gc_safe, save_last_error, null_check, pinvoke;
+} WjGexNativeSite;
+
+static gboolean
+wj_gex_native_type_ok (MonoType *t, gboolean pinvoke, gboolean ret)
+{
+	if (m_type_is_byref (t))
+		return !ret;
+	t = mini_get_underlying_type (t);
+	switch (t->type) {
+	case MONO_TYPE_VOID: return ret;
+	case MONO_TYPE_I1: case MONO_TYPE_U1: case MONO_TYPE_I2: case MONO_TYPE_U2: case MONO_TYPE_I4: case MONO_TYPE_U4:
+	case MONO_TYPE_I8: case MONO_TYPE_U8: case MONO_TYPE_I: case MONO_TYPE_U: case MONO_TYPE_PTR: case MONO_TYPE_FNPTR:
+	case MONO_TYPE_R4: case MONO_TYPE_R8:
+		return TRUE;
+	case MONO_TYPE_BOOLEAN: case MONO_TYPE_CHAR:
+		return !pinvoke;   /* a P/Invoke marshals bool as a 4-byte BOOL and char by charset */
+	case MONO_TYPE_OBJECT: case MONO_TYPE_STRING: case MONO_TYPE_CLASS: case MONO_TYPE_SZARRAY: case MONO_TYPE_ARRAY:
+		return !pinvoke;
+	default:
+		return FALSE;
+	}
+}
+
+static GHashTable *wj_gex_native_sites;   /* MonoMethod* -> WjGexNativeSite* (or the miss marker); compile section */
+static WjGexNativeSite wj_gex_native_miss;
+
+gpointer
+mono_wasm_jit_gex_native_site (MonoMethod *m)
+{
+#ifdef HOST_GEX
+	static int enabled = -1;
+	WjGexNativeSite *site;
+	MonoMethod *target = m;
+	MonoMethodSignature *sig;
+	gpointer addr = NULL;
+	gboolean pinvoke, gc_safe = TRUE, last_error = FALSE;
+	if (enabled < 0)
+		enabled = !g_getenv ("GEXMONO_WASM_JIT_NATIVE") || atoi (g_getenv ("GEXMONO_WASM_JIT_NATIVE")) != 0;
+	if (!enabled || !m)
+		return NULL;
+	if (!wj_gex_native_sites)
+		wj_gex_native_sites = g_hash_table_new (NULL, NULL);
+	site = (WjGexNativeSite *) g_hash_table_lookup (wj_gex_native_sites, m);
+	if (site)
+		return site == &wj_gex_native_miss ? NULL : site;
+	site = &wj_gex_native_miss;
+	if (m->wrapper_type == MONO_WRAPPER_MANAGED_TO_NATIVE) {
+		WrapperInfo *info = mono_marshal_get_wrapper_info (m);
+		target = info && info->subtype == WRAPPER_SUBTYPE_NONE ? info->d.managed_to_native.method : NULL;
+	} else if (m->wrapper_type != MONO_WRAPPER_NONE)
+		target = NULL;
+	if (!target || target->is_generic || target->is_inflated || mono_class_is_gtd (target->klass) || mono_class_is_ginst (target->klass))
+		goto out;
+	pinvoke = (target->flags & METHOD_ATTRIBUTE_PINVOKE_IMPL) != 0;
+	if (!pinvoke && !(target->iflags & METHOD_IMPL_ATTRIBUTE_INTERNAL_CALL))
+		goto out;
+	if ((target->iflags & METHOD_IMPL_ATTRIBUTE_SYNCHRONIZED) || target->string_ctor)
+		goto out;
+	sig = mono_method_signature_internal (target);
+	if (!sig || sig->call_convention == MONO_CALL_VARARG || sig->param_count > 16)
+		goto out;
+	if (sig->hasthis && (pinvoke || m_class_is_valuetype (target->klass)))
+		goto out;
+	if (pinvoke && sig->marshalling_disabled)
+		pinvoke = FALSE;   /* DisableRuntimeMarshalling: the identity for everything the type check admits */
+	if (!wj_gex_native_type_ok (sig->ret, pinvoke, TRUE))
+		goto out;
+	for (int i = 0; i < sig->param_count; ++i) {
+		MonoType *t = sig->params [i];
+		if (!wj_gex_native_type_ok (t, pinvoke, FALSE))
+			goto out;
+		/* a P/Invoke copies a non-blittable struct behind a byref; an InternalCall passes the address as is */
+		if (pinvoke && m_type_is_byref (t)) {
+			MonoClass *k = mono_class_from_mono_type_internal (t);
+			if (!m_class_is_valuetype (k) || !m_class_is_blittable (k))
+				goto out;
+		}
+	}
+	if (pinvoke) {
+		ERROR_DECL (error);
+		MonoMethodPInvoke *piinfo = (MonoMethodPInvoke *) target;
+		addr = mono_lookup_pinvoke_call_internal (target, error);
+		if (!is_ok (error)) {
+			mono_error_cleanup (error);
+			goto out;
+		}
+		last_error = (piinfo->piflags & PINVOKE_ATTRIBUTE_SUPPORTS_LAST_ERROR) != 0;
+	} else {
+		gboolean uses_handles = FALSE, foreign = FALSE;
+		addr = (gpointer) mono_lookup_internal_call_full (target, FALSE, &uses_handles, &foreign);
+		if (uses_handles)
+			goto out;
+		gc_safe = foreign;
+	}
+	if (!addr || !gexp_is_guest_fn ((guint64)(gsize) addr))
+		goto out;
+	site = g_new0 (WjGexNativeSite, 1);
+	site->sig = sig;
+	site->addr = addr;
+	site->gc_safe = gc_safe;
+	site->save_last_error = last_error;
+	site->null_check = sig->hasthis;
+	site->pinvoke = pinvoke;
+	{
+		extern int mono_wasm_jit_verbose;
+		if (mono_wasm_jit_verbose >= 1) {
+			char *fn = mono_method_get_full_name (target);
+			printf ("WASM_JIT_GEX_NATIVE %s (%s%s)\n", fn, pinvoke ? "pinvoke" : "icall", gc_safe ? ", gc-safe" : "");
+			g_free (fn);
+		}
+	}
+out:
+	g_hash_table_insert (wj_gex_native_sites, m, site);
+	return site == &wj_gex_native_miss ? NULL : site;
+#else
+	return NULL;
+#endif
+}
+
+#ifdef HOST_GEX
+/* Its own frame, so that the GexArgs in the caller's frame lies above the GC-safe stack mark and is scanned:
+ * the arguments may be the only references left to their objects while the guest runs. */
+static MONO_NEVER_INLINE guint64
+wj_gex_native_safe (gpointer addr, GexGuestCall *c)
+{
+	MONO_STACKDATA (stack_data);
+	gpointer cookie = mono_threads_enter_gc_safe_region_internal (&stack_data);
+	guint64 raised = gexp_call_guest_catching ((guint64)(gsize) addr, c);
+	mono_threads_exit_gc_safe_region_internal (cookie, &stack_data);
+	return raised;
+}
+#endif
+
+/* The call itself: the residual's scratch layout (this, then the arguments, 8 bytes a slot; the result at +192),
+ * and its result convention (1 = the callee threw). */
+int
+mono_wasm_jit_gex_native_call (gpointer psite, guint8 *buf)
+{
+#ifdef HOST_GEX
+	extern void mono_wasm_jit_throw (MonoObject *exc);
+	WjGexNativeSite *site = (WjGexNativeSite *) psite;
+	MonoMethodSignature *sig = site->sig;
+	GexArgs a;
+	int idx = 0;
+	guint64 raised;
+	memset (&a, 0, sizeof (a));
+	a.c.win64 = gex_guest_abi_win64;
+	a.c.stack = a.stack;
+	if (G_UNLIKELY (mono_wasm_jit_stats))
+		mono_wasm_jit_count (WJC_GEX_NATIVE_CALL);
+	if (site->null_check) {
+		gpointer self = *(gpointer *) buf;
+		if (G_UNLIKELY (!self)) {
+			mono_wasm_jit_throw ((MonoObject *) mono_get_exception_null_reference ());
+			return 1;
+		}
+		gex_add_int (&a, (guint64)(gsize) self);
+		idx = 1;
+	}
+	for (int i = 0; i < sig->param_count; ++i)
+		gex_add_arg (&a, sig->params [i], sig, (stackval *) (buf + (idx + i) * 8));
+	if (site->save_last_error)
+		mono_marshal_clear_last_error ();
+	if (site->gc_safe)
+		raised = wj_gex_native_safe (site->addr, &a.c);
+	else
+		raised = gexp_call_guest_catching ((guint64)(gsize) site->addr, &a.c);
+	if (site->save_last_error)
+		mono_marshal_set_last_error ();
+	if (raised) {
+		if (raised != 1)
+			mono_set_pending_exception ((MonoException *)(gsize) raised);
+	} else if (!MONO_TYPE_IS_VOID (sig->ret)) {
+		guint8 *r = buf + WJ_SCRATCH_RET_OFF;
+		MonoType *rt = m_type_is_byref (sig->ret) ? NULL : mini_get_underlying_type (sig->ret);
+		memset (r, 0, 8);
+		if (rt && rt->type == MONO_TYPE_R4) {
+			guint32 bits = (guint32) a.c.xmm0;
+			memcpy (r, &bits, 4);
+		} else if (rt && rt->type == MONO_TYPE_R8) {
+			memcpy (r, &a.c.xmm0, 8);
+		} else {
+			stackval sv;
+			guint64 rax = a.c.rax;
+			stackval_from_data (sig->ret, &sv, &rax, site->pinvoke);
+			memcpy (r, &sv.data.l, 8);
+		}
+	}
+	/* The wrapper's last act (emit_thread_interrupt_checkpoint), and the interpreter's EXCEPTION_CHECKPOINT after a
+	 * native call: a pending exception -- the guest's own, or an abort -- is thrown here. */
+	if (G_UNLIKELY (mono_thread_interruption_request_flag)) {
+		MonoException *exc = mono_thread_interruption_checkpoint ();
+		if (exc) {
+			mono_wasm_jit_throw ((MonoObject *) exc);
+			return 1;
+		}
+	}
+	return 0;
+#else
+	(void) psite; (void) buf;
+	return 1;
+#endif
+}
+
 static int wj_call_interp_inner (MonoMethod *method, guint8 *buf, InterpMethod *known_imethod);
 

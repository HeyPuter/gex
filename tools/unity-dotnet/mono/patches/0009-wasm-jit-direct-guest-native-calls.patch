+	WJC_GEX_NATIVE_SITE,       /* gex: a direct InternalCall/P-Invoke site into guest code (mono_wasm_jit_gex_native_site) */
+	WJC_GEX_NATIVE_CALL,       /* gex: executions of those sites (counted only with MONO_WASM_JIT_STATS) */
 	WJC_MAX
 };
 

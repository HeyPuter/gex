wasm jit: a lazy stub's interpreter leg derives nothing per call (gex)

A call through a lazy f-slot whose callee is not compiled ran
mono_wasm_get_call_info on every call (lazy_interp) and looked the callee's
InterpMethod up by method hash (lazy_bind -> pretransform): 0.13 s and 0.30 s
of a 20 s Hollow Knight profile (hg13). The slot caches its signature shape,
and the bind pretransforms with the slot's own InterpMethod.

diff --git a/src/mono/mono/mini/interp/interp.c b/src/mono/mono/mini/interp/interp.c
index 7b657f37d..64edfe400 100644
--- a/src/mono/mono/mini/interp/interp.c
+++ b/src/mono/mono/mini/interp/interp.c
@@ -7073,10 +7073,27 @@ mono_wasm_jit_late_fslot (InterpMethod *imethod)
 static __thread MonoMethod *wasm_jit_pretransformed_method;
 static __thread InterpMethod *wasm_jit_pretransformed_imethod;
 
+static void wj_pretransform (MonoMethod *method, InterpMethod *imethod);
+
 void
 mono_wasm_jit_pretransform (MonoMethod *method)
 {
-	InterpMethod *imethod = mono_interp_get_imethod (method);
+	wj_pretransform (method, mono_interp_get_imethod (method));
+}
+
+/* gex: the same with the callee's InterpMethod already known (a lazy slot's owner); a retired one is looked up. */
+void
+mono_wasm_jit_pretransform_im (MonoMethod *method, gpointer known)
+{
+	InterpMethod *imethod = (InterpMethod *) known;
+	if (G_UNLIKELY (!imethod || imethod->retired || imethod->method != method))
+		imethod = mono_interp_get_imethod (method);
+	wj_pretransform (method, imethod);
+}
+
+static void
+wj_pretransform (MonoMethod *method, InterpMethod *imethod)
+{
 	ERROR_DECL (error);
 	if (G_UNLIKELY (!wasm_jit_prepare_interp_callee (method, imethod, error))) {
 		/* A cold callee's first transform/signature/code-type warmup failed (cctor threw / unloadable type /

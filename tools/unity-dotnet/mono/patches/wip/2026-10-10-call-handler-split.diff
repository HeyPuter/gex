+/* gex: give every OP_CALL_HANDLER a continuation block. The emitter runs a finally as "finally_ind = the
+ * continuation's block index; goto handler", so the continuation must start a block. Mono's own passes put
+ * code between a CALL_HANDLER and the leave's OP_BR -- out-of-SSA parks phi moves there (copies that, on a
+ * native target, run after the handler call returns) -- and branch optimization deletes the BR when its
+ * target is the next block. Those methods were refused as "finally: complex call_handler continuation"
+ * (tk2dSprite.UpdateMaterial and GUILayoutGroup.CalcHeight in Hollow Knight, UnmanagedMemoryStream.ReadByte
+ * in the BCL). Here the instructions after a CALL_HANDLER move to a new block that follows it, reached by
+ * an OP_BR, so they run after the finally exactly as they would natively; the CFG edges other than the
+ * handler's move with them. Runs before any analysis, so every later pass sees the split blocks. */
+static void
+wj_split_call_handler_blocks (MonoCompile *cfg)
+{
+	MonoBasicBlock *bb;
+	for (bb = cfg->bb_entry; bb; bb = bb->next_bb) {
+		MonoInst *ins;
+		if (!bb->has_call_handler)
+			continue;
+		for (ins = bb->code; ins; ins = ins->next) {
+			MonoInst *nx, *br;
+			MonoBasicBlock *nb, *handler;
+			int k;
+			if (ins->opcode != OP_CALL_HANDLER)
+				continue;
+			nx = ins->next;
+			while (nx && (nx->opcode == OP_NOP || nx->opcode == OP_IL_SEQ_POINT || nx->opcode == OP_SEQ_POINT))
+				nx = nx->next;
+			if (!nx || (nx->opcode == OP_BR && nx->inst_target_bb))
+				break;   /* already the shape the emitter wants; the rest of bb is skipped after the handler */
+			handler = ins->inst_target_bb;
+			if (g_getenv ("WJDBG_FLUSH")) { char *_fn = mono_method_full_name (cfg->method, TRUE); printf ("WJDBG split %s BB%d\n", _fn, bb->block_num); fflush (stdout); g_free (_fn); }
+			nb = (MonoBasicBlock *) mono_mempool_alloc0 (cfg->mempool, sizeof (MonoBasicBlock));
+			nb->block_num = (int) cfg->max_block_num + 1;
+			cfg->max_block_num = nb->block_num;
+			cfg->num_bblocks++;
+			nb->region = bb->region;
+			nb->real_offset = bb->real_offset;
+			nb->has_call_handler = 1;
+			/* move the tail */
+			nb->code = ins->next;
+			nb->code->prev = NULL;
+			nb->last_ins = bb->last_ins;
+			br = (MonoInst *) mono_mempool_alloc0 (cfg->mempool, sizeof (MonoInst));
+			br->opcode = OP_BR;
+			br->dreg = -1;
+			MONO_INST_NULLIFY_SREGS (br);
+			br->cil_code = ins->cil_code;
+			br->inst_target_bb = nb;
+			ins->next = br; br->prev = ins; br->next = NULL;
+			bb->last_ins = br;
+			/* edges: everything but the handler leaves with the tail */
+			for (k = bb->out_count - 1; k >= 0; --k) {
+				MonoBasicBlock *o = bb->out_bb [k];
+				if (o == handler)
+					continue;
+				mono_unlink_bblock (cfg, bb, o);
+				mono_link_bblock (cfg, nb, o);
+			}
+			mono_link_bblock (cfg, bb, nb);
+			nb->next_bb = bb->next_bb;
+			bb->next_bb = nb;
+			if (cfg->bb_exit == bb)
+				cfg->bb_exit = nb;
+			break;   /* the loop over next_bb visits nb next, for any further CALL_HANDLER in the tail */
+		}
+	}
+}

+/* gex: the gate strings inside every non-opcode bucket, with the first method each refused, so
+ * "synchronized/other 287" names its reasons. Keyed by the literal's address; stats-only, so a race
+ * costs at most a lost count. */
+#define WJ_BAIL_WHY_MAX 96
+static struct { const char *why; char *first; guint32 n; } wj_bail_why [WJ_BAIL_WHY_MAX];
+static void
+wj_bail_why_note (const char *why, const char *mname)
+{
+	int i;
+	for (i = 0; i < WJ_BAIL_WHY_MAX; ++i) {
+		if (wj_bail_why [i].why == why) { wj_bail_why [i].n++; return; }
+		if (!wj_bail_why [i].why) {
+			wj_bail_why [i].first = g_strdup (mname ? mname : "?");
+			wj_bail_why [i].n = 1;
+			wj_bail_why [i].why = why;
+			return;
+		}
+	}
+}

}

static void gexgpu_server_release_object(struct gexgpu_server *server, uint32_t type, void *object)
{
    switch (type)
    {
        case GEXGPU_TYPE_Adapter:
            server->procs.adapterRelease((WGPUAdapter)object);
            break;
        case GEXGPU_TYPE_BindGroup:
            server->procs.bindGroupRelease((WGPUBindGroup)object);
            break;
        case GEXGPU_TYPE_BindGroupLayout:
            server->procs.bindGroupLayoutRelease((WGPUBindGroupLayout)object);
            break;
        case GEXGPU_TYPE_Buffer:
            server->procs.bufferRelease((WGPUBuffer)object);
            break;
        case GEXGPU_TYPE_CommandBuffer:
            server->procs.commandBufferRelease((WGPUCommandBuffer)object);
            break;
        case GEXGPU_TYPE_CommandEncoder:
            server->procs.commandEncoderRelease((WGPUCommandEncoder)object);
            break;
        case GEXGPU_TYPE_ComputePassEncoder:
            server->procs.computePassEncoderRelease((WGPUComputePassEncoder)object);
            break;
        case GEXGPU_TYPE_ComputePipeline:
            server->procs.computePipelineRelease((WGPUComputePipeline)object);
            break;
        case GEXGPU_TYPE_Device:
            server->procs.deviceRelease((WGPUDevice)object);
            break;
        case GEXGPU_TYPE_ExternalTexture:
            server->procs.externalTextureRelease((WGPUExternalTexture)object);
            break;
        case GEXGPU_TYPE_Instance:
            server->procs.instanceRelease((WGPUInstance)object);
            break;
        case GEXGPU_TYPE_PipelineLayout:
            server->procs.pipelineLayoutRelease((WGPUPipelineLayout)object);
            break;
        case GEXGPU_TYPE_QuerySet:
            server->procs.querySetRelease((WGPUQuerySet)object);
            break;
        case GEXGPU_TYPE_Queue:
            server->procs.queueRelease((WGPUQueue)object);
            break;
        case GEXGPU_TYPE_RenderBundle:
            server->procs.renderBundleRelease((WGPURenderBundle)object);
            break;
        case GEXGPU_TYPE_RenderBundleEncoder:
            server->procs.renderBundleEncoderRelease((WGPURenderBundleEncoder)object);
            break;
        case GEXGPU_TYPE_RenderPassEncoder:
            server->procs.renderPassEncoderRelease((WGPURenderPassEncoder)object);
            break;
        case GEXGPU_TYPE_RenderPipeline:
            server->procs.renderPipelineRelease((WGPURenderPipeline)object);
            break;
        case GEXGPU_TYPE_Sampler:
            server->procs.samplerRelease((WGPUSampler)object);
            break;
        case GEXGPU_TYPE_ShaderModule:
            server->procs.shaderModuleRelease((WGPUShaderModule)object);
            break;
        case GEXGPU_TYPE_Surface:
            server->procs.surfaceRelease((WGPUSurface)object);
